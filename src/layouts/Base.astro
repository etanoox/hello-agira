---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';
import '../styles/cinematic.css';
import { websiteGraph, serializeSchema } from '../lib/schema';
import photos from '../data/photos.json';
import type { Locale } from '../lib/i18n';
interface Props { socialPhoto?: keyof typeof photos; socialImage?: string; socialImageAlt?: string; lang: Locale; title: string; description: string; errorPage?: boolean; canonicalPath?: string; alternatePaths?: { it: string; en: string }; }
const { lang, title, description, socialPhoto = 'hero', socialImage, socialImageAlt, errorPage = false, canonicalPath = `/${lang}/`, alternatePaths = { it: '/it/', en: '/en/' } } = Astro.props;
const photo = photos[socialPhoto];
const socialImagePath = socialImage ?? `/images/${socialPhoto}-${Math.max(...photo.widths.filter(width => width <= 1800))}.webp`;
const imageAlt = socialImageAlt ?? photo.alt[lang];
const ready = Astro.site?.protocol === 'https:' && !errorPage;
const canonical = ready ? new URL(canonicalPath, Astro.site).href : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TG2VSHS8');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#073e38" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={ready ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ready && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="it" href={new URL(alternatePaths.it, Astro.site).href} />
      <link rel="alternate" hreflang="en" href={new URL(alternatePaths.en, Astro.site).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths.it, Astro.site).href} />
      <script type="application/ld+json" set:html={serializeSchema(websiteGraph(Astro.site!, lang, title, canonicalPath))} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hello Agira" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'en_GB' : 'it_IT'} />
    {ready && <meta property="og:url" content={canonical} />}
    {ready && <><meta property="og:image" content={new URL(socialImagePath, Astro.site).href}/><meta property="og:image:alt" content={imageAlt}/><meta name="twitter:image" content={new URL(socialImagePath, Astro.site).href}/><meta name="twitter:image:alt" content={imageAlt}/></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body id="top">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TG2VSHS8"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot /><script>import '../scripts/ui';</script>
  </body>
</html>
