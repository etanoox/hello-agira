---
import '../../styles/itineraries.css';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Map from '../../components/Map.astro';
import JourneyHero from '../../components/JourneyHero.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import photos from '../../data/photos.json';
import { getCopy } from '../../data/copy';
import { anchor, pageUrl, sightUrl, itineraryUrl, type ItineraryId, sectionIds, type Locale, type Section } from '../../lib/i18n';
export async function getStaticPaths() {
  const entries = await getCollection('home', ({ data }) => data.status === 'published');
  return entries.map(entry => ({ params: { lang: entry.data.lang }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = entry.data.lang as Locale;
const c = getCopy(lang);
const l = (it: string, en: string) => lang === 'it' ? it : en;
const homeSights = c.sights.map(s => s.id === 'town' ? {
  id: 'canadianCemetery', image: 'canadianCemetery',
  tag: l('Un luogo di memoria', 'A place of remembrance'),
  title: l('Il Cimitero di guerra canadese', 'Agira Canadian War Cemetery'),
  text: l('Un luogo di memoria per i militari canadesi caduti durante la campagna di Sicilia, affacciato sul paesaggio di Agira.', 'A place of remembrance for Canadian service members who fell during the Sicily campaign, overlooking the landscape of Agira.'),
  detail: l('Visita questo luogo con rispetto e scopri la sua storia con l’audioguida in italiano o in inglese. Usa le cuffie durante l’ascolto.', 'Visit respectfully and discover its history with the audio guide in Italian or English. Use headphones while listening.'),
  href: sightUrl('canadianCemetery', lang),
} : { ...s, href: s.id === 'castle' || s.id === 'abbey' ? sightUrl(s.id, lang) : undefined });
const homeMoreSights = [c.moreSights[0], {
  title: l('La Grotta di San Filippo', 'The Cave of San Filippo'),
  text: l('Un antico ambiente scavato nella roccia, tra storia e devozione per il patrono di Agira.', 'An ancient chamber carved into the rock, shaped by history and devotion to Agira’s patron saint.'),
  href: sightUrl('saintPhilipCave', lang),
  link: l('Scopri la grotta', 'Explore the cave'),
}, {
  title: l('La Chiesa di Sant’Antonio di Padova', 'Church of Saint Anthony of Padua'),
  text: l('La facciata, la cupola e i tesori d’arte: scopri la chiesa con le audioguide in italiano e in inglese.', 'Discover the façade, dome and artistic treasures of the church with audio guides in Italian and English.'),
  href: sightUrl('saintAnthony', lang),
  link: l('Scopri la chiesa e ascolta l’audioguida', 'Explore the church and listen to the audio guide'),
}, {
  title: l('La Collegiata di Santa Maria Maggiore', 'The Collegiate Church of Santa Maria Maggiore'),
  text: l('Due navate asimmetriche, capitelli romanici e opere d’arte da scoprire con calma.', 'Two asymmetrical naves, Romanesque capitals and artworks to discover at your own pace.'),
  href: sightUrl('santaMariaMaggiore', lang),
  link: l('Scopri la Collegiata', 'Explore the collegiate church'),
}, {
  title: l('La Chiesa di Santa Margherita', 'The Church of Santa Margherita'),
  text: l('Tre navate, una grande cupola e opere d’arte tra sculture, dipinti e legni intagliati.', 'Three naves, a great dome and artworks spanning sculpture, painting and carved wood.'),
  href: sightUrl('santaMargherita', lang),
  link: l('Scopri la chiesa', 'Explore the church'),
}];
const { Content } = await render(entry);
const a = (key: Section) => anchor(key, lang);
const id = (key: Section) => sectionIds[key][lang];
---
<Base socialPhoto="hero" lang={lang} title={entry.data.title} description={entry.data.description}>
  <SiteHeader lang={lang}/>

  <main id="main" tabindex="-1">
    <JourneyHero lang={lang}/>

    <section id={id('discover')} class="section intro-section" aria-labelledby="intro-title">
      <div class="container intro-grid">
        <div><p class="eyebrow">{c.introLabel}</p><h2 id="intro-title" class="display-title">{c.introTitle}</h2></div>
        <div class="intro-copy"><div class="prose-copy"><Content/></div><div class="inline-links">{(['history','sights','info'] as Section[]).map((key,i)=><a href={a(key)}>{c.introLinks[i]}<Icon name="diagonal"/></a>)}</div></div>
      </div>
      <div class="container gateway-grid">{c.gateways.map(g => <a class="gateway" href={a(g.key)}><span class="gateway-number">{g.number}</span><h3>{g.title}</h3><p>{g.text}</p><Icon name="diagonal"/></a>)}</div>
    </section>

    <section id={id('sights')} class="section sights-section" aria-labelledby="sights-title">
      <div class="container">
        <p class="eyebrow">{c.sightsLabel}</p>
        <div class="section-heading"><div><h2 id="sights-title">{c.sightsTitle}</h2><p>{c.sightsText}</p></div><a class="text-link" href={a('map')}>{c.onMap}<Icon name="diagonal"/></a></div>
        <div class="sight-reel" data-reel>
          <div class="reel-toolbar"><p>{lang === 'it' ? 'Tre luoghi. Tre punti di vista.' : 'Three places. Three perspectives.'}</p><div class="reel-navigation"><span data-reel-count aria-live="polite">01 / 03</span><button data-reel-prev aria-label={lang === 'it' ? 'Luogo precedente' : 'Previous place'}><Icon name="arrow"/></button><button data-reel-next aria-label={lang === 'it' ? 'Luogo successivo' : 'Next place'}><Icon name="arrow"/></button></div></div>
          <div class="sight-track" data-reel-track tabindex="0" role="region" aria-label={lang === 'it' ? 'Fotografie e luoghi di Agira' : 'Photographs and places in Agira'}>{homeSights.map((s,i) => <article class={`sight-card sight-${i}`}>
            <figure><a class="photo-link" href={`/images/${s.image}-1800.webp`} data-gallery-open={s.image} aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${s.title}`}><Photo name={s.image as keyof typeof photos} lang={lang} sizes="(max-width: 700px) 90vw, 56vw"/><span class="photo-view"><Icon name="plus"/></span></a><figcaption>0{i+1} / {s.tag}</figcaption></figure>
            <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3><p>{s.text}</p>{s.href && <a class="text-link" href={s.href}>{lang === 'it' ? 'Scopri il luogo' : 'Explore this place'}<Icon name="arrow"/></a>}<details class="sight-details"><summary>{c.details}<Icon name="plus"/></summary><p>{s.detail}</p></details>
          </article>)}</div>
          <div class="reel-bottom"><span>{lang === 'it' ? 'Trascina, scorri, esplora.' : 'Drag, scroll, explore.'}</span><div class="reel-progress" aria-hidden="true"><i data-reel-progress></i></div></div>
        </div>
        <div class="more-sights">{homeMoreSights.map(s => <article><h3>{s.title}</h3><p>{s.text}</p><a class="text-link" href={s.href}>{s.link}<Icon name="diagonal"/></a></article>)}</div>
      </div>
    </section>

    <section id={id('routes')} class="section routes-section" aria-labelledby="routes-title"><div class="container">
      <p class="eyebrow">{c.routesLabel}</p><div class="section-heading"><h2 id="routes-title">{c.routesTitle}</h2><p>{c.routesIntro}</p></div>
      <div class="route-grid route-grid--extended">{c.routes.map((route,i)=><article class="route-card"><div class="route-top"><span class="route-index">0{i+1}</span><span class="route-time">{route.time}</span></div><h3><a href={itineraryUrl((['first', 'day', 'weekend', 'saintPhilip', 'baronialPalaces'] as ItineraryId[])[i], lang)}>{route.title}</a></h3><p>{route.text}</p><details><summary>{c.routeOpen}<Icon name="plus"/></summary><ol>{route.stops.map(s=><li>{s}</li>)}</ol></details><a class="text-link itinerary-open" href={itineraryUrl((['first', 'day', 'weekend', 'saintPhilip', 'baronialPalaces'] as ItineraryId[])[i], lang)}>{lang === 'it' ? 'Esplora l’itinerario' : 'Explore this itinerary'}<Icon name="arrow"/></a></article>)}</div>
    </div></section>

    <section id={id('eat')} class="section eat-section" aria-labelledby="eat-title"><div class="container food-grid">
      <div><p class="eyebrow">{c.eatLabel}</p><h2 id="eat-title">{c.eatTitle}</h2></div>
      <div class="food-copy"><p class="lead-copy">{c.eatText}</p><div class="food-options">{c.eatItems.map((item,i)=><div><span class="small-number">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><a class="text-link" href={pageUrl('eat', lang)}>{c.eatPageAction}<Icon name="arrow"/></a></div>
    </div></section>

    <section id={id('pastry')} class="pastry-section" aria-labelledby="pastry-title">
      <div class="container pastry-grid">
        <div class="pastry-copy"><p class="eyebrow">{c.pastryLabel}</p><h2 id="pastry-title">{c.pastryTitle}</h2><h3>{c.pastryName}</h3><p>{c.pastryText}</p><a class="button button-yellow" href={pageUrl('cassatella', lang)}>{lang === 'it' ? 'Scopri la Cassatella di Agira' : 'Discover Cassatella di Agira'}<Icon name="arrow"/></a></div>
        <div class="pastry-visual"><span class="pastry-giant" aria-hidden="true">Cassatella.</span><figure><a class="photo-link" href="/images/cassatelleAnello9903-1800.webp" data-gallery-open="cassatelleAnello9903" aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${c.pastryName}`}><Photo name="cassatelleAnello9903" lang={lang}/><span class="photo-view"><Icon name="plus"/></span></a><figcaption>{c.pastryName} <span>{photos.cassatelleAnello9903.credit?.[lang]}</span></figcaption></figure><div class="pastry-tags">{c.pastryTags.map(t=><span>{t}</span>)}</div></div>
      </div>
    </section>

    <section id={id('stay')} class="stay-section" aria-labelledby="stay-title"><div class="stay-photo"><Photo name="town" lang={lang} sizes="(max-width: 700px) 100vw, 55vw"/></div><div class="stay-copy"><p class="eyebrow">{c.stayLabel}</p><h2 id="stay-title">{c.stayTitle}</h2><p>{c.stayText}</p><ul class="stay-checks">{c.stayChecks.map(check=><li><span aria-hidden="true">↗</span>{check}</li>)}</ul><a class="text-link" href={pageUrl('stay', lang)}>{c.stayCta}<Icon name="arrow"/></a></div></section>

    <section id={id('events')} class="section events-section" aria-labelledby="events-title"><div class="container event-grid"><div><p class="eyebrow">{c.eventsLabel}</p><h2 id="events-title">{c.eventsTitle}</h2><p>{c.eventsIntro}</p><div class="button-row"><a class="button button-yellow" href={pageUrl('events', lang)}>{c.eventsPageCta}<Icon name="arrow"/></a></div></div><div><div class="event-list">{c.events.map(event=><article><p class="eyebrow">{event.tag}</p><h3>{event.title}</h3><p>{event.text}</p>{'href' in event && <a class="text-link" href={event.href}>{event.link}<Icon name="arrow"/></a>}</article>)}</div></div></div></section>

    <Map lang={lang}/>

    <section id={id('history')} class="section history-section" aria-labelledby="history-title"><div class="container history-grid"><p class="eyebrow">{c.historyLabel}</p><div><h2 id="history-title">{c.historyTitle}</h2><p>{c.historyText}</p><a class="text-link" href={pageUrl('history', lang)}>{c.historyCta}<Icon name="diagonal"/></a><div class="history-borghi"><p>{l('Dal 2023 Agira fa parte dei Borghi più belli d’Italia. Un riconoscimento che invita a scoprire il centro storico, i suoi paesaggi e le tradizioni della comunità.', 'Since 2023, Agira has been a member of Italy’s Most Beautiful Villages association. This recognition invites you to discover the historic centre, its landscapes and the community’s traditions.')}</p><a class="text-link" href={pageUrl('beautifulVillages', lang)}>{l('Agira tra i Borghi più belli d’Italia', 'Agira among Italy’s Most Beautiful Villages')}<Icon name="diagonal"/></a></div></div><div class="history-words" aria-hidden="true"><span>Agyrion</span><span>Diodoro</span><span>San Filippo</span></div></div></section>

    <section id={id('info')} class="section info-section" aria-labelledby="info-title"><div class="container info-grid"><div><p class="eyebrow">{c.infoLabel}</p><h2 id="info-title">{c.infoTitle}</h2></div><div class="info-list">{c.info.map((info,i)=><details><summary><span class="small-number">0{i+1}</span><h3>{info.title}</h3><Icon name="plus"/></summary><div class="info-answer"><p>{info.text}</p>{'href' in info && <a class="text-link" href={info.href}>{info.link}<Icon name="diagonal"/></a>}</div></details>)}</div></div></section>
  </main>

  <SiteFooter lang={lang}/>

  <PhotoGallery lang={lang} extraItems={[
    {key:'etnaPozzilloMoon',title:lang === 'it' ? 'L’Etna e il lago Pozzillo al chiaro di luna' : 'Mount Etna and Lake Pozzillo by moonlight'},
    {key:'castleEtnaDusk',title:lang === 'it' ? 'Il Castello e l’Etna al crepuscolo' : 'Agira Castle and Mount Etna at dusk'},
    {key:'agiraFireworks',title:lang === 'it' ? 'Fuochi d’artificio sopra Agira' : 'Fireworks above Agira'},
    {key:'agiraSunsetPanorama',title:lang === 'it' ? 'Agira al tramonto' : 'Agira at sunset'},
    {key:'agiraGoldenHour',title:lang === 'it' ? 'Agira nella luce del tramonto' : 'Agira in the evening light'},
    {key:'agiraMistTown',title:lang === 'it' ? 'Agira avvolta dalla nebbia' : 'Agira wrapped in mist'},
    {key:'agiraPozzilloTrail',title:lang === 'it' ? 'Sentiero panoramico sul lago Pozzillo' : 'A scenic trail above Lake Pozzillo'},
    {key:'abbeyFestivalLights',title:lang === 'it' ? 'L’Abbazia illuminata per la festa' : 'The abbey lit for the feast'},
    {key:'agiraPozzilloMistySunset',title:lang === 'it' ? 'Foschia sul lago all’alba' : 'Mist over the lake at sunrise'},
    {key:'agiraEtnaLakeSunset',title:lang === 'it' ? 'L’Etna nella sua prima luce' : 'Mount Etna in the first light'},
    {key:'agiraPozzilloGoldenHour',title:lang === 'it' ? 'Etna e lago Pozzillo all’alba' : 'Mount Etna and Lake Pozzillo at sunrise'},
    {key:'agiraEtnaPozzilloSunset',title:lang === 'it' ? 'Il sole dietro l’Etna' : 'Sunset behind Mount Etna'},
    {key:'agiraDittainoSunset',title:lang === 'it' ? 'L’alba sulle colline' : 'Sunrise over the hills'},
    {key:'agiraSunsetTown',title:lang === 'it' ? 'Agira al tramonto' : 'Agira at sunset'},
    {key:'agiraEtnaPanorama',title:lang === 'it' ? 'Agira e l’Etna innevato' : 'Agira and snow-covered Mount Etna'},
  ]}/>
  <script>import '../../scripts/motion';</script>
</Base>

<style>
  .history-borghi { margin-top: 2rem; }
</style>
