---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import PlaceAudioGuide from './PlaceAudioGuide.astro';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import type { SightPage } from '../data/sight-pages';
import { sightUrl, pageUrl, homeUrl, itineraryUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
import '../styles/sight-detail.css';
interface Props { place: SightPage; lang: Locale }
const { place, lang } = Astro.props;
const l = (it: string,en: string) => lang === 'it' ? it : en;
const alternatePaths = {it:sightUrl(place.id,'it'),en:sightUrl(place.id,'en')};
const query=encodeURIComponent(place.mapQuery);
const mapUrl=`https://www.google.com/maps/search/?api=1&query=${query}`;
const directions=`https://www.google.com/maps/dir/?api=1&destination=${query}`;
const mapEmbed=`https://www.google.com/maps?q=${query}&output=embed&hl=${lang}`;
const fullImage=(key:keyof typeof photos)=>`/images/${key}-${Math.max(...photos[key].widths.filter(width=>width<=1800))}.webp`;
const credit=(key:keyof typeof photos)=>photos[key].credit?.[lang] ?? `${photos[key].author ?? ''}${photos[key].license ? ` · ${photos[key].license}` : ''}`;
const ready=Astro.site?.protocol==='https:';
const url=ready ? new URL(alternatePaths[lang],Astro.site).href : undefined;
const structured=ready ? {
  '@context':'https://schema.org', '@graph':[
    {'@type':'TouristAttraction','@id':`${url}#place`,name:place.name,description:place.description,url,
      image:new URL(fullImage(place.image),Astro.site).href,
      address:{'@type':'PostalAddress',addressLocality:'Agira',addressRegion:'Sicilia',addressCountry:'IT'},hasMap:mapUrl},
    {'@type':'BreadcrumbList',itemListElement:[
      {'@type':'ListItem',position:1,name:'Hello Agira',item:new URL(homeUrl(lang),Astro.site).href},
      {'@type':'ListItem',position:2,name:l('Cosa vedere','Things to see'),item:new URL(pageUrl('sights',lang),Astro.site).href},
      {'@type':'ListItem',position:3,name:place.name,item:url},
    ]},
  ],
} : undefined;
---
<Base lang={lang} title={place.title} description={place.description} canonicalPath={alternatePaths[lang]} alternatePaths={alternatePaths}>
  <SiteHeader lang={lang} currentPage="sights" alternatePaths={alternatePaths}/>
  <main id="main" tabindex="-1" class="place-detail">
    <section class="place-hero" aria-labelledby="place-title">
      <Photo name={place.image} lang={lang} priority class="place-hero-image" sizes="100vw"/>
      <div class="place-hero-shade"></div>
      <div class="container place-hero-content">
        <nav class="place-breadcrumb" aria-label={l('Percorso di navigazione','Breadcrumb')}><a href={pageUrl('sights',lang)}>{l('Cosa vedere','Things to see')}</a><span aria-hidden="true"> / </span><span aria-current="page">{place.name}</span></nav>
        <p class="eyebrow">{place.category}</p><h1 id="place-title">{place.name}<span>.</span></h1>
        <div class="place-hero-bottom"><p><Icon name="pin"/>{place.location}</p><a href={fullImage(place.image)} data-gallery-open={place.image} aria-haspopup="dialog" aria-label={l('Apri la fotografia del luogo','Open the place photograph')}><Icon name="plus"/>{l('Guarda la foto','View photo')}</a></div>
      </div>
    </section>
    <div class="container place-layout">
      <div class="place-main">
        <section class="place-introduction" aria-label={l('Presentazione','Introduction')}><p class="eyebrow">{l('01 / IL LUOGO','01 / THE PLACE')}</p><p class="place-lead">{place.introduction}</p>
          <div class="place-actions">{place.audio && <a class="button button-green" href="#audioguida">{l('Ascolta l’audioguida','Listen to the audio guide')}<Icon name="arrow"/></a>}<a class="button button-yellow" href={directions} target="_blank" rel="noopener noreferrer">{l('Ottieni indicazioni','Get directions')}<Icon name="diagonal"/></a><a class="text-link" href="#storia">{l('Scopri la storia','Discover the history')}<Icon name="arrow"/></a></div>
        </section>
        {place.audio && <PlaceAudioGuide guide={place.audio} lang={lang}/>}
        <section id="storia" class="place-story" aria-labelledby="place-story-heading"><p class="eyebrow">{l('LA STORIA E IL PAESAGGIO','HISTORY AND LANDSCAPE')}</p><h2 id="place-story-heading">{place.story[0].title}</h2>{place.story[0].paragraphs.map(text=><p>{text}</p>)}{place.story.slice(1).map(section=><div class="place-story-part"><h3>{section.title}</h3>{section.paragraphs.map(text=><p>{text}</p>)}</div>)}</section>
        <section class="place-highlights" aria-labelledby="look-heading"><p class="eyebrow">{l('FERMATI A GUARDARE','TAKE A CLOSER LOOK')}</p><h2 id="look-heading">{l('I dettagli fanno il luogo.','Details make the place.')}</h2><ol>{place.highlights.map((item,i)=><li><span aria-hidden="true">0{i+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol></section>
      </div>
      <aside class="place-sidebar" aria-label={l('Informazioni per la visita','Visitor information')}>
        <section class="place-facts"><p class="eyebrow">{l('PRIMA DI PARTIRE','BEFORE YOU SET OFF')}</p><h2>{l('La visita, in breve.','Your visit, at a glance.')}</h2><dl>{place.facts.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl><p class="place-facts-note">{l('Per accessi e condizioni di visita, verifica con il Comune.','Check access and visiting conditions with the municipality.')}</p><a class="text-link" href="https://www.comune.agira.en.it/" target="_blank" rel="noopener noreferrer">{l('Comune di Agira','Municipality of Agira')}<Icon name="diagonal"/></a></section>
        <section class="place-map-card" aria-labelledby="place-map-heading"><h2 id="place-map-heading">{l('Dove si trova','Where to find it')}</h2><p>{place.location}</p><div class="place-map" data-place-map><div class="place-map-cover" data-map-cover><Icon name="pin"/><span>{place.name}</span><button class="button button-green" type="button" data-load-map hidden>{l('Carica mappa Google','Load Google map')}</button><p>{l('La mappa viene caricata da Google solo quando la apri.','Google’s map loads only when you open it.')}</p></div><iframe hidden data-src={mapEmbed} title={`${l('Mappa','Map')}: ${place.name}`} loading="lazy" allowfullscreen tabindex="0"></iframe></div><a class="text-link" href={mapUrl} target="_blank" rel="noopener noreferrer">{l('Apri in Google Maps','Open in Google Maps')}<Icon name="diagonal"/></a></section>
        <section class="place-practical"><h2>{l('Informazioni utili','Useful information')}</h2>{place.practical.map((item,i)=><details open={i===0}><summary>{item.title}<Icon name="plus"/></summary><p>{item.text}</p></details>)}</section>
      </aside>
    </div>
    <section class="place-photographs container" aria-labelledby="place-photos-heading"><div class="section-heading"><div><p class="eyebrow">{l('IL LUOGO, IN IMMAGINI','THE PLACE, IN PICTURES')}</p><h2 id="place-photos-heading">{l('Cambia punto di vista.','Change your perspective.')}</h2></div><p>{l('Uno sguardo ai dettagli e al paesaggio che li circonda.','A closer look at the details and the surrounding landscape.')}</p></div><div class="place-photo-grid">{place.gallery.map(item=><figure><a class="photo-link" href={fullImage(item.key)} data-gallery-open={item.key} aria-haspopup="dialog" aria-label={`${l('Apri la fotografia','Open photograph')}: ${item.title}`}><Photo name={item.key} lang={lang} sizes="(max-width: 700px) 90vw, 48vw"/><span class="photo-view"><Icon name="plus"/></span></a><figcaption><span>{item.title}</span>{photos[item.key].source ? <a href={photos[item.key].source!}>{credit(item.key)}</a> : <span>{credit(item.key)}</span>}</figcaption></figure>)}</div></section>
    <section class="place-sources container" aria-labelledby="place-sources-heading"><details><summary id="place-sources-heading">{l('Fonti per approfondire','Sources for further reading')}<Icon name="plus"/></summary><ul>{place.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<Icon name="diagonal"/></a></li>)}</ul></details></section>
    <section class="place-next"><div class="container"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA','KEEP EXPLORING')}</p><h2>{l('Una tappa.\nTante direzioni.','One stop.\nMany directions.')}</h2><p>{l('Continua a esplorare Agira, lasciando spazio alle soste.','Keep exploring Agira, with time for breaks.')}</p></div><div class="place-next-links"><a class="button button-yellow" href={itineraryUrl('day',lang)}>{l('L’itinerario di un giorno','The one-day itinerary')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('sights',lang)}>{l('Tutti i luoghi di Agira','All the sights of Agira')}<Icon name="arrow"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} currentPage="sights" alternatePaths={alternatePaths}/>
  <PhotoGallery lang={lang} items={place.gallery}/>
  {structured && <script type="application/ld+json" set:html={serializeSchema(structured)}/>}
  <script>import '../scripts/place-map';</script>
</Base>
