---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import photos from '../data/photos.json';
import { getCopy } from '../data/copy';
import { anchor, homeUrl, pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = getCopy(lang);
const localizedPaths = { it: pageUrl('sights', 'it'), en: pageUrl('sights', 'en') };
const photoCredit = (name: keyof typeof photos) => photos[name];
const photoCreditLabel = (photo: typeof photos[keyof typeof photos]) => photo.credit?.[lang] ?? `© ${photo.author} · ${photo.license}`;
const featuredPageExtras = c.sightsPageExtras.filter((s) => 'image' in s) as Array<{ image: keyof typeof photos; tag: string; title: string; text: string; detail: string }>;
const textPageExtras = c.sightsPageExtras.filter((s) => !('image' in s));
const featuredSights = [...c.sights, ...featuredPageExtras];
const mapHref = `${homeUrl(lang)}${anchor('map', lang)}`;
const routesHref = pageUrl('routes', lang);
---

<Base lang={lang} title={c.sightsPageTitle} description={c.sightsPageDescription} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="sights"/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero sights-page-hero" aria-labelledby="sights-page-title">
      <div class="container route-page-hero-grid">
        <div class="route-page-copy">
          <p class="eyebrow">{c.sightsPageEyebrow}</p>
          <h1 id="sights-page-title">{c.sightsPageHeading}</h1>
          <p>{c.sightsText}</p>
          <a class="button button-yellow" href="#sights-collection">{c.sightsPageAction}<Icon name="arrow"/></a>
        </div>
        <figure class="route-page-photo">
          <a class="photo-link sights-hero-photo" href="/images/hero-2400.webp" data-gallery-open="hero" aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${lang === 'it' ? 'Agira e il suo paesaggio' : 'Agira and its countryside'}`}>
            <Photo name="hero" lang={lang} priority sizes="(max-width: 700px) 90vw, 48vw"/>
            <span class="photo-view"><Icon name="plus"/></span>
          </a>
          <figcaption>{lang === 'it' ? 'Agira, tra il paese e il paesaggio' : 'Agira, between town and countryside'} <span>© Stelmb · CC BY-SA 4.0</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="sights-collection" class="section sights-page-section" aria-labelledby="sights-collection-title">
      <div class="container">
        <p class="eyebrow">{lang === 'it' ? '01 / CINQUE SGUARDI' : '01 / FIVE PERSPECTIVES'}</p>
        <div class="section-heading sights-page-heading">
          <h2 id="sights-collection-title">{c.sightsPageListTitle}</h2>
          <p>{c.sightsPageListIntro}</p>
        </div>

        <div class="sights-editorial-grid">
          {featuredSights.map((s, i) => {
            const image = s.image as keyof typeof photos;
            const credit = photoCredit(image);
            const fullImageWidth = Math.min(1800, credit.width);
            return <article class={`sights-editorial-card sights-editorial-card-${i + 1}`}>
              <figure>
                <a class="photo-link" href={`/images/${s.image}-${fullImageWidth}.webp`} data-gallery-open={s.image} aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${s.title}`}>
                  <Photo name={image} lang={lang} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 70vw, 50vw"/>
                  <span class="photo-view"><Icon name="plus"/></span>
                </a>
                <figcaption><span>0{i + 1} / {s.tag}</span><a href={credit.source}>{photoCreditLabel(credit)}<Icon name="diagonal"/></a></figcaption>
              </figure>
              <div class="sights-editorial-copy">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <details class="sight-details"><summary>{c.details}<Icon name="plus"/></summary><p>{s.detail}</p></details>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>

    <section class="sights-more-section" aria-labelledby="sights-more-title">
      <div class="container">
        <div class="sights-more-heading"><p class="eyebrow">02 / {lang === 'it' ? 'ALTRI SGUARDI' : 'MORE TO DISCOVER'}</p><h2 id="sights-more-title">{c.sightsPageMoreTitle}</h2></div>
        <div class="sights-more-grid">
          {[...c.moreSights, ...textPageExtras].map((s, i) => <article class="sights-more-card">
            <span class="sights-more-index">0{i + 4}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p><a class="text-link" href={s.href}>{s.link}<Icon name="diagonal"/></a></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="itinerary-next sights-page-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{lang === 'it' ? 'IL VIAGGIO CONTINUA' : 'KEEP EXPLORING'}</p><h2>{lang === 'it' ? 'Da qui, il viaggio prende forma.' : 'Let the journey take shape.'}</h2></div>
        <div class="itinerary-next-links">
          <a class="button button-yellow" href={routesHref}>{c.sightsPageRoutes}<Icon name="arrow"/></a>
          <a class="text-link" href={mapHref}>{c.sightsPageMap}<Icon name="diagonal"/></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="sights"/>
  <PhotoGallery lang={lang}/>
  <script>import '../scripts/sights-reveal';</script>
</Base>
