---
import photos from '../data/photos.json';
import { imageFile, type ImageKey } from '../lib/image-metadata';
import type { Locale } from '../lib/i18n';
interface Props { name: ImageKey; lang: Locale; class?: string; priority?: boolean; sizes?: string; decorative?: boolean; }
const { name, lang, class: className, priority = false, sizes = '(max-width: 700px) 100vw, 50vw', decorative = false } = Astro.props;
const photo = photos[name];
const candidates = photo.widths.filter(width => width <= 1200);
const sourceWidth = candidates.length ? Math.max(...candidates) : Math.min(...photo.widths);
if (!decorative) Astro.locals.imageKeys?.add(name);
---
<img class={className} src={imageFile(name, sourceWidth)} srcset={photo.widths.map(w => `${imageFile(name, w)} ${w}w`).join(', ')} sizes={sizes} width={photo.width} height={photo.height} alt={decorative ? '' : photo.alt[lang]} data-decorative={decorative || undefined} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
