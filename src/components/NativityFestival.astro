---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import EventPhotoSection from './EventPhotoSection.astro';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import galleryData from '../data/nativity-gallery.json';
import { getNativityFestival } from '../data/nativity-festival';
import { pageUrl, sightUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
import { getReligiousEventGraph } from '../data/religious-events';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getNativityFestival(lang);
const paths = { it: pageUrl('nativity', 'it'), en: pageUrl('nativity', 'en') };
const hero = 'nativitySanfilippo7586' as const;
const items = galleryData.map(item => ({ key: item.key as keyof typeof photos, title: item.title[lang] }));
const fullImage = (key: keyof typeof photos) => `/images/${key}-${Math.max(...photos[key].widths)}.webp`;
const videos = [
  { year: 2025, id: '4jQFX7mSD-A' },
  { year: 2024, id: 'TTNHiWpcQ_c' },
  { year: 2023, id: '4h8SvJhhEnQ' },
];
const structured = Astro.site?.protocol === 'https:' ? getReligiousEventGraph(Astro.site, lang, 'nativity') : undefined;
---
<Base socialPhoto={hero} lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="events" alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="nativity-title">
      <div class="container">
        <p class="eyebrow festival-topline">{c.eyebrow}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <h1 id="nativity-title">{c.heading}</h1><p>{c.intro}</p>
            <div class="festival-date-lockup"><span>{l('LA PROSSIMA EDIZIONE', 'THE NEXT EDITION')}</span><div><strong>24</strong><p>{l('DICEMBRE', 'DECEMBER')}<br/>2026</p></div></div>
            <a class="button button-yellow" href="#edizione-2026">{l('L’edizione 2026', 'The 2026 edition')}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo">
            <a class="photo-link" href={fullImage(hero)} data-gallery-open={hero} aria-haspopup="dialog" aria-label={l('Ingrandisci la fotografia della Natività', 'Enlarge the Nativity photograph')}><Photo name={hero} lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></a>
            <figcaption><span>{l('La Natività', 'The Nativity')}</span><span>{photos[hero].credit[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section id="edizione-2026" class="festival-edition" aria-labelledby="nativity-edition-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date"><p class="eyebrow">{l('36ª EDIZIONE · 2026', '36TH EDITION · 2026')}</p><h2 id="nativity-edition-title">{c.editionTitle}</h2><p>{c.editionText}</p></div>
        <div class="festival-programme"><span class="festival-programme-index" aria-hidden="true">24</span><h3>{c.programmeTitle}</h3><p>{c.programmeText}</p><div class="festival-plan-links"><a class="text-link" href={pageUrl('nessunDormaChristmas', lang)}>{l('Dopo mezzanotte: Natale al Nessun Dorma', 'After midnight: Christmas at Nessun Dorma')}<Icon name="arrow"/></a></div></div>
      </div>
    </section>
    <section id="programma-2026" class="section festival-schedule-section" aria-labelledby="nativity-programme-title">
      <div class="container">
        <div class="festival-schedule-heading"><div><p class="eyebrow">24 / 25 · 12 · 2026</p><h2 id="nativity-programme-title">{l('Il programma ufficiale.', 'The official programme.')}</h2></div><p>{l('Gli appuntamenti della 36ª edizione del Presepe Vivente di Agira.', 'The 36th edition’s schedule.')}</p></div>
        <ol class="festival-schedule-list">{c.programme.map(item => <li><time datetime={item.datetime}>{item.time}</time><div><h3>{item.title}</h3><p><strong>{item.place}</strong> · {item.text}</p></div></li>)}</ol>
        <p class="nativity-info-links"><a class="text-link" href={sightUrl('salvatore', lang)}>{l('La chiesa del SS. Salvatore', 'The Church of SS. Salvatore')}<Icon name="arrow"/></a></p>
      </div>
    </section>
    <section id="scene-2026" class="section" aria-labelledby="nativity-scenes-title">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">{l('NOVITÀ 2026 · MICHEA', 'NEW FOR 2026 · MICAH')}</p><h2 id="nativity-scenes-title">{l('Dalla profezia alla Natività.', 'From prophecy to Nativity.')}</h2></div><p>{l('Cinque scene accompagnano il racconto. Quest’anno si aggiunge la profezia di Michea, legata a Betlemme.', 'Five scenes tell the story. This year introduces Micah’s prophecy concerning Bethlehem.')}</p></div>
        <ol class="nativity-scenes-list">{c.scenes.map(scene => <li><h3>{scene.title}</h3><p>{scene.text}</p></li>)}</ol>
      </div>
    </section>
    {c.sections.map((section, index) => <section id={section.id} class={index % 2 === 0 ? 'festival-story section' : 'festival-plan section nativity-muted'} aria-labelledby={`${section.id}-title`}>
      <div class="container festival-story-grid"><div><p class="eyebrow">{section.label}</p><h2 id={`${section.id}-title`}>{section.title}</h2></div><div class="festival-story-copy">
        {section.paragraphs.map(text => <p>{text}</p>)}
        {index === 0 && <div class="festival-plan-links"><a class="text-link" href={sightUrl('castle', lang)}>{l('Scopri il Castello di Agira', 'Discover Agira Castle')}<Icon name="arrow"/></a></div>}
      </div></div>
    </section>)}
    <section id="video" class="section" aria-labelledby="nativity-video-title">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">{l('04 / IL RACCONTO IN VIDEO', '04 / THE VIDEO STORY')}</p><h2 id="nativity-video-title">{l('Tre edizioni, una tradizione.', 'Three editions, one tradition.')}</h2></div><p>{l('Rivivi il Presepe Vivente di Agira nelle edizioni 2025, 2024 e 2023. Tutti i video sono di Sandro Bellomo.', 'Revisit Agira’s Living Nativity in 2025, 2024 and 2023. All videos are by Sandro Bellomo.')}</p></div>
        <div class="nativity-video-grid">
          {videos.map(video => <article class="nativity-video-card">
            <h3>{l('Edizione', 'Edition')} {video.year}</h3>
            <div data-nativity-video data-video-id={video.id}>
              <div data-video-cover>
                <span class="nativity-video-year" aria-hidden="true">{video.year}</span>
                <button type="button" class="button button-yellow" data-load-video hidden aria-label={l('Guarda il video', 'Watch the video') + ' ' + video.year}>{l('Guarda il video', 'Watch the video')}<Icon name="arrow"/></button>
                <p>{l('Al clic carichi YouTube e acconsenti al trattamento dei dati tecnici e agli eventuali cookie del servizio. Puoi revocare la scelta nelle preferenze cookie.', 'Clicking loads YouTube and consents to its processing of technical data and any service cookies. You can withdraw this choice in Cookie preferences.')}</p>
              </div>
              <iframe title={l('Presepe Vivente di Agira', 'Agira Living Nativity') + ' ' + video.year + ' · Sandro Bellomo'} hidden allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
            <p class="nativity-video-credit">Sandro Bellomo · <a class="text-link" href={'https://www.youtube.com/watch?v=' + video.id} target="_blank" rel="noopener noreferrer">{l('Apri su YouTube', 'Open on YouTube')}<Icon name="diagonal"/></a></p>
          </article>)}
        </div>
      </div>
    </section>
    <EventPhotoSection lang={lang} titleId="nativity-photos-title" items={items}
      eyebrow={l('05 / IL RACCONTO FOTOGRAFICO', '05 / THE PHOTOGRAPHIC STORY')}
      title={l('Quindici sguardi, una notte.', 'Fifteen views, one night.')}
      intro={l('Scene delle edizioni precedenti, nelle fotografie di Filippo Sanfilippo.', 'Scenes from previous editions, photographed by Filippo Sanfilippo.')}/>
    <section class="stay-practical-section section" aria-labelledby="nativity-faq-title">
      <div class="container stay-practical-grid">
        <div class="stay-practical-intro"><p class="eyebrow">{l('06 / PRIMA DI PARTIRE', '06 / BEFORE YOU SET OFF')}</p><h2 id="nativity-faq-title">{l('Preparare la visita.', 'Plan your visit.')}</h2></div>
        <div class="stay-practical-list">
          {c.faqs.map((faq, index) => <details><summary><span class="small-number">0{index + 1}</span><h3>{faq.q}</h3><Icon name="plus"/></summary><div class="stay-practical-answer"><p>{faq.a}</p></div></details>)}
        </div>
      </div>
    </section>
    <section class="section nativity-muted nativity-contacts" aria-labelledby="nativity-contacts-title"><div class="container">
      <div class="section-heading"><div><p class="eyebrow">{l('INFORMAZIONI E CONTATTI', 'INFORMATION AND CONTACTS')}</p><h2 id="nativity-contacts-title">{l('Informazioni dagli organizzatori.', 'Information from the organisers.')}</h2></div>
      <p>{l('Associazione Amici del Presepe · Contatti ufficiali.', 'Associazione Amici del Presepe · Official contacts.')}</p>
      </div>
      <ul class="festival-visit-list">{c.contacts.map((phone, i) => <li>
        <div class="festival-visit-top"><p>{l('INFORMAZIONI', 'INFORMATION')}</p><span class="small-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div>
        <h3>Associazione Amici del Presepe</h3>
        <div class="festival-visit-actions"><a class="button button-yellow" href={'tel:+39' + phone.replaceAll(' ', '')} aria-label={l('Chiama', 'Call') + ' ' + phone}><span>{l('Chiama', 'Call')}<br/>{phone}</span><Icon name="diagonal"/></a></div>
      </li>)}</ul>
    </div></section>
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Una notte ad Agira.\nTante storie da scoprire.', 'A night in Agira.\nMany stories to discover.')}</h2></div><div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('events', lang)}>{l('Tutti gli eventi', 'All events')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('stay', lang)}>{l('Dove dormire', 'Where to stay')}<Icon name="diagonal"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} currentPage="events" alternatePaths={paths}/>
  <script>import '../scripts/nativity-video';</script>
  <PhotoGallery lang={lang} items={items}/>
  {structured && <script type="application/ld+json" set:html={serializeSchema(structured)}/>}
</Base>
<style>
  .festival-visit-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:3rem 0 0;padding:0}
  .festival-visit-list>li{display:flex;flex-direction:column;min-width:0;background:var(--white);border:1px solid var(--line);border-top:3px solid var(--forest);border-radius:2px;padding:1.8rem}
  .festival-visit-top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}
  .festival-visit-top p{font-size:.75rem;line-height:1.5;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
  .festival-visit-top .small-number{flex-shrink:0}
  .festival-visit-list h3,.festival-shuttle h3{font-size:clamp(1.6rem,2.5vw,2rem);line-height:1.15;letter-spacing:-.04em;margin:0 0 1.3rem;overflow-wrap:anywhere}
  .festival-visit-list p,.festival-shuttle p{line-height:1.65}
  .festival-visit-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem;margin-top:auto;padding-top:1.5rem}
  .festival-visit-actions .button,.festival-shuttle .button{font-size:.875rem;min-height:48px;padding:.8rem 1.2rem;gap:1rem;max-width:100%;white-space:normal;text-align:left}
  .festival-visit-actions .button svg,.festival-shuttle .button svg{width:18px;height:18px;flex-shrink:0}
  .festival-visit-actions .text-link{font-size:.875rem}
  .festival-visit-actions .button span,.festival-shuttle .button span{line-height:1.6;overflow-wrap:anywhere}
  .festival-schedule-section{background:#073e38;color:var(--stone)}
  .festival-schedule-section .eyebrow{color:var(--grain)}
  .festival-schedule-heading h2{max-width:720px;margin-top:.85rem;font-size:clamp(3rem,6vw,5.8rem);line-height:.94;letter-spacing:-.07em}
  .festival-schedule-list{list-style:none;margin:1.5rem 0 0;padding:0}
  .festival-schedule-list li{display:grid;grid-template-columns:8rem minmax(0,1fr);gap:1.5rem;padding:1.3rem 0;border-top:1px solid #ffffff35}
  .festival-schedule-list li:last-child{border-bottom:1px solid #ffffff35}
  .festival-schedule-list time{font-family:var(--display);font-size:2rem;line-height:1;color:var(--grain);letter-spacing:-.05em}
  .festival-schedule-list h4{margin:0;font-family:var(--display);font-weight:600;font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.25;letter-spacing:-.025em}
  .festival-schedule-list p{max-width:760px;margin-top:.35rem;font-size:.9rem;line-height:1.6;color:#d8e0d9}
    .festival-schedule-list li{grid-template-columns:5rem minmax(0,1fr);gap:.85rem;padding:1.1rem 0}
    .festival-schedule-list time{font-size:1.55rem}
.festival-visit-list h3{font-size:clamp(1.6rem,2.5vw,2rem);line-height:1.15;letter-spacing:-.04em;margin:0 0 1.3rem;overflow-wrap:anywhere}
.festival-schedule-heading{display:grid;grid-template-columns:1fr;gap:1.5rem}
.festival-schedule-heading>p{color:#d8e0d9;line-height:1.6}
.festival-schedule-list h3{margin:0;font-family:var(--display);font-weight:600;font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.25;letter-spacing:-.025em;color:var(--stone)}
.festival-schedule-section .nativity-info-links a{color:var(--grain)}
@media(max-width:700px){.festival-visit-list{grid-template-columns:1fr;gap:1rem;margin-top:2rem}.festival-visit-list>li{padding:1.5rem 1.3rem}.festival-schedule-list li{grid-template-columns:5rem minmax(0,1fr);gap:.85rem;padding:1.1rem 0}.festival-schedule-list time{font-size:1.55rem}}

.nativity-scenes-list{list-style:none;margin:0;padding:0}
.nativity-scenes-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}
.nativity-scenes-list li{padding:1.5rem;background:var(--stone);border-top:3px solid var(--forest)}
.nativity-scenes-list p{margin-top:.6rem;line-height:1.65}
.nativity-info-links{display:flex;flex-wrap:wrap;gap:1.5rem;list-style:none;padding:0;margin-top:1.5rem}
@media(max-width:700px){.nativity-scenes-list{grid-template-columns:1fr}}

.nativity-video-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem}
.nativity-video-card{min-width:0}
.nativity-video-card:first-child{grid-column:1/-1}
.nativity-video-card h3{margin-bottom:1rem}
[data-video-cover]{padding:clamp(1rem,3vw,2rem);background:var(--forest);color:var(--stone);display:flex;flex-direction:column;align-items:flex-start;gap:1rem}
.nativity-video-year{font-size:clamp(2.5rem,6vw,5rem);font-weight:700;line-height:1}
[data-video-cover] p{max-width:55rem;font-size:.8rem;line-height:1.6;color: var(--stone)}
[data-nativity-video] iframe{width:100%;aspect-ratio:16/9;border:0}
.nativity-video-credit{margin-top:1rem;font-size:.85rem}
@media(max-width:700px){.nativity-video-grid{grid-template-columns:1fr}}
.nativity-muted{background:#e8eadf}
</style>
