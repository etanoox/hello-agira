---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import galleryData from '../data/nativity-gallery.json';
import { getNativityFestival } from '../data/nativity-festival';
import { pageUrl, sightUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
import { getReligiousEventGraph } from '../data/religious-events';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getNativityFestival(lang);
const paths = { it: pageUrl('nativity', 'it'), en: pageUrl('nativity', 'en') };
const hero = 'nativitySanfilippo7586' as const;
const items = galleryData.map(item => ({ key: item.key as keyof typeof photos, title: item.title[lang] }));
const fullImage = (key: keyof typeof photos) => `/images/${key}-${Math.max(...photos[key].widths)}.webp`;
const sources = [
  { name: 'EnnaPress · ' + l('Il riconoscimento 2025/2026 e la 36ª edizione', 'The 2025/2026 award and the 36th edition'), href: 'https://ennapress.it/il-presepe-di-agira-premiato-come-il-migliore-presepe-vivente-ditalia/' },
  { name: l('Comune di Agira · Programma natalizio 2023', 'Municipality of Agira · Christmas programme 2023'), href: 'https://www.comune.agira.en.it/it/news/1625595' },
  { name: 'VivaSicilia · Presepe Vivente di Agira', href: 'https://www.vivasicilia.com/presepe-vivente-agira/' },
];
const structured = Astro.site?.protocol === 'https:' ? getReligiousEventGraph(Astro.site, lang, 'nativity') : undefined;
---
<Base socialPhoto={hero} lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="events" alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="nativity-title">
      <div class="container">
        <p class="eyebrow festival-topline">{c.eyebrow}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <h1 id="nativity-title">{c.heading}</h1><p>{c.intro}</p>
            <div class="festival-date-lockup"><span>{l('LA PROSSIMA EDIZIONE', 'THE NEXT EDITION')}</span><div><strong>24</strong><p>{l('DICEMBRE', 'DECEMBER')}<br/>2026</p></div></div>
            <a class="button button-yellow" href="#edizione-2026">{l('L’edizione 2026', 'The 2026 edition')}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo">
            <a class="photo-link" href={fullImage(hero)} data-gallery-open={hero} aria-haspopup="dialog" aria-label={l('Ingrandisci la fotografia della Natività', 'Enlarge the Nativity photograph')}><Photo name={hero} lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></a>
            <figcaption><span>{l('La Natività', 'The Nativity')}</span><span>{photos[hero].credit[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section id="edizione-2026" class="festival-edition" aria-labelledby="nativity-edition-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date"><p class="eyebrow">{l('36ª EDIZIONE · 2026', '36TH EDITION · 2026')}</p><h2 id="nativity-edition-title">{c.editionTitle}</h2><p>{c.editionText}</p></div>
        <div class="festival-programme"><span class="festival-programme-index" aria-hidden="true">24</span><h3>{c.programmeTitle}</h3><p>{c.programmeText}</p></div>
      </div>
    </section>
    {c.sections.map((section, index) => <section id={section.id} class={index % 2 === 0 ? 'festival-story section' : 'festival-plan section nativity-muted'} aria-labelledby={`${section.id}-title`}>
      <div class="container festival-story-grid"><div><p class="eyebrow">{section.label}</p><h2 id={`${section.id}-title`}>{section.title}</h2></div><div class="festival-story-copy">
        {section.paragraphs.map(text => <p>{text}</p>)}
        {index === 0 && <div class="festival-plan-links"><a class="text-link" href={sightUrl('castle', lang)}>{l('Scopri il Castello di Agira', 'Discover Agira Castle')}<Icon name="arrow"/></a></div>}
      </div></div>
    </section>)}
    <section id="fotografie" class="section nativity-muted" aria-labelledby="nativity-photos-title">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">{l('04 / IL RACCONTO FOTOGRAFICO', '04 / THE PHOTOGRAPHIC STORY')}</p><h2 id="nativity-photos-title">{l('Quindici sguardi, una notte.', 'Fifteen views, one night.')}</h2></div><p>{l('Scene delle edizioni precedenti, nelle fotografie di Filippo Sanfilippo.', 'Scenes from previous editions, photographed by Filippo Sanfilippo.')}</p></div>
        <div class="nativity-photo-grid">{items.map((item, index) => <figure>
          <a class="photo-link" href={fullImage(item.key)} data-gallery-open={item.key} aria-haspopup="dialog" aria-label={`${l('Ingrandisci', 'Enlarge')}: ${item.title}`}><Photo name={item.key} lang={lang} sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 29vw"/><span class="photo-view"><Icon name="plus"/></span></a>
          <figcaption><span>{String(index + 1).padStart(2, '0')} / {item.title}</span><span>{photos[item.key].credit?.[lang]}</span></figcaption>
        </figure>)}</div>
      </div>
    </section>
    <section class="stay-practical-section section" aria-labelledby="nativity-faq-title">
      <div class="container stay-practical-grid">
        <div class="stay-practical-intro"><p class="eyebrow">{l('05 / PRIMA DI PARTIRE', '05 / BEFORE YOU SET OFF')}</p><h2 id="nativity-faq-title">{l('Preparare la visita.', 'Plan your visit.')}</h2></div>
        <div class="stay-practical-list">
          {c.faqs.map((faq, index) => <details><summary><span class="small-number">0{index + 1}</span><h3>{faq.q}</h3><Icon name="plus"/></summary><div class="stay-practical-answer"><p>{faq.a}</p></div></details>)}
          <details><summary><span class="small-number">05</span><h3>{l('Fonti per approfondire', 'Sources for further reading')}</h3><Icon name="plus"/></summary><div class="stay-practical-answer">{sources.map(source => <p><a class="text-link" href={source.href} target="_blank" rel="noopener noreferrer">{source.name}<Icon name="diagonal"/></a></p>)}</div></details>
        </div>
      </div>
    </section>
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Una notte ad Agira.\nTante storie da scoprire.', 'A night in Agira.\nMany stories to discover.')}</h2></div><div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('events', lang)}>{l('Tutti gli eventi', 'All events')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('stay', lang)}>{l('Dove dormire', 'Where to stay')}<Icon name="diagonal"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} currentPage="events" alternatePaths={paths}/>
  <PhotoGallery lang={lang} items={items}/>
  {structured && <script type="application/ld+json" set:html={serializeSchema(structured)}/>}
</Base>
<style>
.nativity-muted{background:#e8eadf}
.nativity-photo-grid{columns:3;column-gap:1.5rem}
.nativity-photo-grid figure{break-inside:avoid;margin:0 0 2rem}
.nativity-photo-grid .photo-link{display:block;position:relative;background:var(--forest-dark)}
.nativity-photo-grid :global(img){display:block;width:100%;height:auto}
.nativity-photo-grid .photo-view{position:absolute;right:.8rem;bottom:.8rem;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--stone);color:var(--forest)}
.nativity-photo-grid .photo-view :global(svg){width:18px;height:18px}
.nativity-photo-grid figcaption{display:flex;flex-direction:column;gap:.3rem;padding-top:.7rem;font-size:.78rem;line-height:1.5}
.nativity-photo-grid figcaption>span:last-child{font-size:.7rem;color:var(--muted)}
@media(max-width:1000px){.nativity-photo-grid{columns:2}}
@media(max-width:700px){.nativity-photo-grid{columns:1}}
</style>
