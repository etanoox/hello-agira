---
import { cassatellaMenus } from '../data/cassatella-menus';
import { imageFile } from '../lib/image-metadata';
import photos from '../data/photos.json';
import type { Locale } from '../lib/i18n';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
---
<section id="menu-della-sagra" class="festival-menus section" aria-labelledby="festival-menus-title">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">{l('04 / A TAVOLA DURANTE LA SAGRA', '04 / EATING DURING THE FESTIVAL')}</p><h2 id="festival-menus-title">{l('I menù della Sagra.', 'Festival menus.')}</h2></div>
      <p>{l('Le proposte dei locali di Agira per una pausa tra gli appuntamenti della Sagra. Apri le immagini per leggere i menù e consulta le date di validità di ogni offerta.', 'Offers from Agira’s eateries for a break between festival events. Open the images to read the menus and check the dates for each offer. The original menus are in Italian.')}</p>
    </div>
    <div class="festival-menu-venues">
      {cassatellaMenus.map(venue => <article class="festival-menu-venue" aria-labelledby={`menu-${venue.id}`}>
        <header class="festival-menu-header">
          <div><p class="eyebrow">{venue.category[lang]}</p><h3 id={`menu-${venue.id}`}>{venue.name}</h3></div>
          {venue.dates && <p class="festival-menu-dates"><span>{l('Offerte valide il', 'Offers valid on')}</span><strong><time datetime={venue.validFrom}>{venue.dates[lang]}</time></strong></p>}
        </header>
        <div class="festival-menu-grid">
          {venue.menus.map(menu => <figure>
            <a class="festival-menu-image" href={imageFile(menu.image, Math.max(...photos[menu.image].widths))} target="_blank" rel="noopener noreferrer" aria-label={`${l('Apri e ingrandisci', 'Open full size')}: ${venue.name} · ${menu.title[lang]}`}>
              <Photo name={menu.image} lang={lang} sizes="(max-width: 700px) 90vw, (max-width: 1200px) 44vw, 560px"/>
            </a>
            <figcaption><span>{menu.title[lang]}</span><a class="text-link" href={imageFile(menu.image, Math.max(...photos[menu.image].widths))} target="_blank" rel="noopener noreferrer" aria-label={`${l('Ingrandisci', 'View full size')}: ${venue.name} · ${menu.title[lang]}`}>{l('Ingrandisci', 'View full size')}<Icon name="diagonal"/></a></figcaption>
          </figure>)}
        </div>
      </article>)}
    </div>
  </div>
</section>
<style>
  .festival-menus{background:var(--stone)}
  .festival-menu-venues{display:grid;gap:2rem;margin-top:3rem}
  .festival-menu-venue{min-width:0;background:var(--white);border:1px solid var(--line);border-top:3px solid var(--forest);border-radius:2px;padding:1.8rem}
  .festival-menu-header{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:1.8rem}
  .festival-menu-header .eyebrow{margin-bottom:.8rem}
  .festival-menu-header h3{font-size:clamp(1.6rem,2.5vw,2rem);line-height:1.15;letter-spacing:-.04em}
  .festival-menu-dates{font-size:.875rem;line-height:1.6}
  .festival-menu-dates span,.festival-menu-dates strong{display:block}
  .festival-menu-dates span{color:var(--muted)}
  .festival-menu-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}
  .festival-menu-grid figure{min-width:0;margin:0}
  .festival-menu-image{display:block;border:1px solid var(--line);background:var(--stone)}
  .festival-menu-image:focus-visible{outline:3px solid var(--forest);outline-offset:4px}
  .festival-menu-image :global(img){display:block;width:100%;height:auto;object-fit:contain}
  .festival-menu-grid figcaption{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1rem;font-size:.875rem}
  .festival-menu-grid .text-link{font-size:.8125rem}
  @media(max-width:700px){.festival-menu-venues{margin-top:2rem}.festival-menu-venue{padding:1.5rem 1.3rem}.festival-menu-header{align-items:flex-start;flex-direction:column;gap:1rem}.festival-menu-grid{grid-template-columns:1fr;gap:2rem}}
</style>
