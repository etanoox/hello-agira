---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import photos from '../data/photos.json';
import { imageFile, type ImageKey } from '../lib/image-metadata';
import type { Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
  titleId: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: { key: ImageKey; title: string }[];
}
const { lang, titleId, eyebrow, title, intro, items } = Astro.props;
const enlarge = lang === 'it' ? 'Ingrandisci' : 'Enlarge';
---

<section id="fotografie" class="section event-photo-section" aria-labelledby={titleId}>
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">{eyebrow}</p><h2 id={titleId}>{title}</h2></div>
      <p>{intro}</p>
    </div>
    <div class="event-photo-grid">
      {items.map((item, index) => <figure>
        <a class="photo-link" href={imageFile(item.key, Math.max(...photos[item.key].widths))} data-gallery-open={item.key} aria-haspopup="dialog" aria-label={`${enlarge}: ${item.title}`}>
          <Photo name={item.key} lang={lang} sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 29vw"/>
          <span class="photo-view"><Icon name="plus"/></span>
        </a>
        <figcaption><span>{String(index + 1).padStart(2, '0')} / {item.title}</span><span>{photos[item.key].credit?.[lang]}</span></figcaption>
      </figure>)}
    </div>
  </div>
</section>

<style>
.event-photo-section{background:#e8eadf}
.event-photo-grid{columns:3;column-gap:1.5rem}
.event-photo-grid figure{break-inside:avoid;margin:0 0 2rem}
.event-photo-grid .photo-link{display:block;position:relative;background:var(--forest-dark)}
.event-photo-grid :global(img){display:block;width:100%;height:auto}
.event-photo-grid .photo-view{position:absolute;right:.8rem;bottom:.8rem;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--stone);color:var(--forest)}
.event-photo-grid .photo-view :global(svg){width:18px;height:18px}
.event-photo-grid figcaption{display:flex;flex-direction:column;gap:.3rem;padding-top:.7rem;font-size:.78rem;line-height:1.5}
.event-photo-grid figcaption>span:last-child{font-size:.7rem;color:var(--muted)}
@media(max-width:1000px){.event-photo-grid{columns:2}}
@media(max-width:700px){.event-photo-grid{columns:1}}
</style>
