---
interface Props { name?: 'arrow' | 'diagonal' | 'plus' | 'pin' | 'menu' | 'close'; class?: string }
const { name = 'arrow', class: className } = Astro.props;
const paths = { arrow: 'M4 12h16m-6-6 6 6-6 6', diagonal: 'M6 18 18 6M6 6h12v12', plus: 'M12 5v14M5 12h14', pin: 'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z', menu: 'M3 7h18M3 17h18', close: 'm6 6 12 12M6 18 18 6' };
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
