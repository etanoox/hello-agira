---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import CassatellaPhotoStory from './CassatellaPhotoStory.astro';
import { pageUrl, type Locale } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const paths = { it: pageUrl('cassatella','it'), en: pageUrl('cassatella','en') };
const title = l('Cassatella di Agira: ingredienti, storia e tradizione | Hello Agira', 'Cassatella di Agira: ingredients, history and tradition | Hello Agira');
const description = l('Scopri la Cassatella di Agira: ingredienti, lavorazione nelle foto di Filippo Anello, storia, dove assaggiarla e percorso verso il riconoscimento IGP.', 'Discover Cassatella di Agira: ingredients, its making in Filippo Anello’s photographs, history, where to taste it and the application for PGI recognition.');
const gazette = 'https://www.gazzettaufficiale.it/atto/serie_generale/caricaDettaglioAtto/originario?atto.codiceRedazionale=26A05067&atto.dataPubblicazioneGazzetta=2026-10-01&elenco30giorni=false';
const article = (n: number) => `https://www.gazzettaufficiale.it/atto/serie_generale/caricaArticolo?art.codiceRedazionale=26A05067&art.dataPubblicazioneGazzetta=2026-10-01&art.flagTipoArticolo=1&art.idArticolo=${n}&art.idGruppo=0&art.idSottoArticolo=1&art.idSottoArticolo1=10&art.progressivo=0&art.versione=1`;
const steps = [
  {title:l('Il ripieno','The filling'),text:l('Mandorle tostate e tritate, cacao, farina di ceci, zucchero, acqua, limone e cannella: il composto viene cotto e lasciato riposare.', 'Toasted, ground almonds, cocoa, chickpea flour, sugar, water, lemon and cinnamon: the mixture is cooked and rested.')},
  {title:l('La sfoglia','The pastry'),text:l('Farina di grano tenero, zucchero, strutto, uova e acqua formano la pasta, che viene fatta riposare e stesa.', 'Wheat flour, sugar, lard, eggs and water form the dough, which is rested and rolled out.')},
  {title:l('La forma','The shape'),text:l('La pasta avvolge il ripieno. Uno stampo o una rotella dentellata disegna la mezzaluna, pronta per il forno.', 'The pastry encloses the filling. A mould or fluted cutter shapes the crescent, ready for the oven.')},
];
---
<Base socialPhoto="cassatelleAnello9938" lang={lang} title={title} description={description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="cass-hero" aria-labelledby="cass-title">
      <div class="container">
        <div class="cass-hero-grid">
          <div class="cass-hero-copy"><p class="eyebrow">{l('AGIRA · SAPORI E TRADIZIONI', 'AGIRA · FLAVOURS AND TRADITIONS')}</p><h1 id="cass-title">Cassatella<br/>di Agira<span>.</span></h1><p class="cass-lead">{l('Una mezzaluna che racconta un paese.', 'A crescent that tells the story of a town.')}</p><p>{l('Fermati sui dettagli, segui i gesti di chi la prepara e scopri uno dei sapori da incontrare durante una visita ad Agira.', 'Look closely, follow the hands that make it and discover a flavour to seek out on your visit to Agira.')}</p><a class="button button-yellow" href="#assaggiare">{l('Dove assaggiarla', 'Where to taste it')}<Icon name="arrow"/></a></div>
          <figure class="cass-hero-photo"><Photo name="cassatelleAnello9938" lang={lang} priority sizes="(max-width: 800px) 92vw, 52vw"/><figcaption>{l('Fotografia di Filippo Anello.', 'Photograph by Filippo Anello.')}</figcaption></figure>
        </div>
        <nav class="cass-index" aria-label={l('In questa pagina', 'On this page')}><a href="#il-dolce">{l('Il dolce', 'The pastry')}</a><a href="#storia">{l('La storia', 'Its history')}</a><a href="#lavorazione">{l('La lavorazione', 'How it is made')}</a><a href="#igp">{l('Il percorso IGP', 'The PGI application')}</a></nav>
      </div>
    </section>
    <section id="il-dolce" class="cass-section section"><div class="container cass-editorial">
      <div><p class="eyebrow">{l('01 / IL DOLCE', '01 / THE PASTRY')}</p><h2>{l('Una forma familiare. Un gusto da scoprire.', 'A familiar shape. A flavour to discover.')}</h2></div>
      <div class="cass-prose"><p>{l('La Cassatella di Agira è un dolce da forno a mezzaluna, con bordo dentellato e un ripieno scuro a base di mandorle, cacao e farina di ceci. Il limone e la cannella ne accompagnano il profumo.', 'Cassatella di Agira is a crescent-shaped baked pastry with a fluted edge and a dark filling of almonds, cocoa and chickpea flour. Lemon and cinnamon add their fragrance.')}</p><p>{l('La cassatella di Agira, da non confondere con altre cassatelle siciliane, ha una dolcezza con una nota amara e una leggera granulosità del ripieno. Un equilibrio da apprezzare con calma, un morso alla volta.', 'Cassatella di Agira, not to be confused with other Sicilian cassatelle, has a sweetness with a bitter note and a lightly grainy filling. Take your time to enjoy the balance, one bite at a time.')}</p><a class="text-link" href={article(2)}>{l('Caratteristiche nel disciplinare proposto', 'Characteristics in the proposed specification')}<Icon name="diagonal"/></a></div>
    </div></section>
    <section id="storia" class="cass-history section"><div class="container cass-editorial">
      <div><p class="eyebrow">{l('02 / IL LEGAME CON AGIRA', '02 / A CONNECTION WITH AGIRA')}</p><h2>{l('Una tradizione che passa di mano in mano.', 'A tradition passed from hand to hand.')}</h2></div>
      <div class="cass-prose"><p>{l('La storia della cassatella vive anche nei ricordi di chi l’ha vista preparare in famiglia. Il disciplinare raccoglie testimonianze orali dei produttori, legate alle ricette di mamme e nonne, risalenti a circa settanta–ottanta anni fa.', 'The story of cassatella also lives in the memories of those who watched it being made at home. The specification records producers’ oral accounts of their mothers’ and grandmothers’ recipes, reaching back some seventy to eighty years.')}</p><p>{l('Un riferimento documentato è il concorso del dolce agirino del 1986, nel quale figurava la “Cassatedda”. Le ipotesi sulle origini più lontane restano distinte da questi riferimenti verificabili.', 'One documented reference is the 1986 Agira pastry competition, which included “Cassatedda”. Ideas about its more distant origins remain separate from these verifiable records.')}</p><a class="text-link" href={article(6)}>{l('Legame con il territorio: la fonte', 'Connection with the area: the source')}<Icon name="diagonal"/></a></div>
    </div></section>
    <section id="lavorazione" class="section cass-process"><div class="container"><p class="eyebrow">{l('03 / LA LAVORAZIONE', '03 / HOW IT IS MADE')}</p><h2>{l('Tre gesti, prima del forno.', 'Three steps before the oven.')}</h2><div class="cass-steps">{steps.map((step,i)=><article><span class="cass-number">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div><a class="text-link" href={article(5)}>{l('Ingredienti e metodo nel disciplinare proposto', 'Ingredients and method in the proposed specification')}<Icon name="diagonal"/></a></div></section>
    <CassatellaPhotoStory lang={lang}/>
    <section id="igp" class="cass-igp section"><div class="container cass-editorial"><div><p class="eyebrow">{l('04 / IL PERCORSO IGP', '04 / THE PGI APPLICATION')}</p><h2>{l('Un nome, un territorio.', 'A name, a place.')}</h2></div><div class="cass-prose"><p class="cass-status">{l('Domanda di registrazione pubblicata', 'Registration application published')}</p><p>{l('Il 1° ottobre 2026 la Gazzetta Ufficiale italiana ha pubblicato la domanda di registrazione IGP e il disciplinare. L’atto prevede trenta giorni per le opposizioni nazionali, prima della successiva trasmissione alla Commissione europea.', 'On 1 October 2026, Italy’s Official Gazette published the PGI application and specification. The notice provides thirty days for national objections before subsequent submission to the European Commission.')}</p><p>{l('Questo passaggio non costituisce il riconoscimento europeo definitivo.', 'This step does not constitute final European recognition.')}</p><a class="text-link" href={gazette}>{l('Consulta l’atto ufficiale', 'Read the official notice')}<Icon name="diagonal"/></a></div></div></section>
    <section id="assaggiare" class="section cass-visit"><div class="container"><p class="eyebrow">{l('05 / ASSAGGIARE AGIRA', '05 / A TASTE OF AGIRA')}</p><h2>{l('Dalla fotografia al primo morso.', 'From the photograph to your first bite.')}</h2><div class="cass-visit-grid"><article><h3>{l('Una pausa in paese', 'A stop in town')}</h3><p>{l('Nella guida “Mangiare” trovi i locali dedicati a cassatelle e dolci, con le indicazioni per raggiungerli. Per ingredienti, allergeni e disponibilità, chiedi direttamente al locale.', 'Our food guide lists places for cassatelle and sweets, with directions. Ask the venue directly about ingredients, allergens and availability.')}</p><a class="button button-yellow" href={`${pageUrl('eat',lang)}#cassatelle-dolci`}>{l('Trova dove assaggiarla', 'Find somewhere to taste it')}<Icon name="arrow"/></a></article><article><h3>{l('La Sagra della Cassatella', 'The Cassatella Festival')}</h3><p>{l('Organizza una visita in occasione della festa: nella pagina dedicata trovi le informazioni sull’edizione in programma e gli appuntamenti delle tre giornate.', 'Plan a visit for the festival: its dedicated page has information about the upcoming edition and the full three-day programme.')}</p><a class="text-link" href={pageUrl('festival',lang)}>{l('Scopri la Sagra', 'Explore the festival')}<Icon name="arrow"/></a></article></div></div></section>
  </main>
  <SiteFooter lang={lang} alternatePaths={paths}/>
</Base>
<style>
.cass-hero{padding:9rem 0 0;background:var(--forest-dark);color:var(--stone)}.cass-hero-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:4rem;align-items:center}.cass-hero-copy .eyebrow{color:var(--grain)}.cass-hero h1{font-size:clamp(3.5rem,7.4vw,7.5rem);line-height:.94;letter-spacing:-.065em;margin:1.5rem 0}.cass-hero h1 span{color:var(--grain)}.cass-hero-copy>p{max-width:440px;line-height:1.7}.cass-hero-copy .cass-lead{font-family:var(--display);font-size:1.5rem;line-height:1.3;margin-bottom:1rem}.cass-hero-copy .button{margin-top:1.7rem}.cass-hero-photo{margin:0;min-width:0}.cass-hero-photo :global(img){width:100%;height:auto;display:block}.cass-hero-photo figcaption{font-size:.75rem;color:#fff;margin-top:.8rem}.cass-index{display:flex;flex-wrap:wrap;gap:.5rem 2rem;border-top:1px solid #ffffff35;margin-top:3rem;padding-block:1rem}.cass-index a{display:flex;align-items:center;min-height:44px;font-size:.87rem}.cass-index a:hover{text-decoration:underline;text-underline-offset:5px}.cass-editorial{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.cass-editorial h2,.cass-process h2,.cass-visit h2{font-size:clamp(2.4rem,4.5vw,4.5rem);line-height:1.03;letter-spacing:-.05em;margin-top:1.2rem;max-width:700px}.cass-prose p{line-height:1.8;font-size:1.05rem;margin-bottom:1.4rem}.cass-prose .text-link,.cass-process>.container>.text-link{font-size:.83rem;line-height:1.5}.cass-history{background:#eae5d9}.cass-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem;margin:3rem 0}.cass-steps article{border-top:1px solid var(--line);padding-top:1.5rem}.cass-number{font-family:var(--display);font-size:2.5rem;opacity:.5}.cass-steps h3{font-size:1.6rem;margin:.5rem 0 1rem}.cass-steps p{line-height:1.75}.cass-igp{background:var(--forest-dark);color:var(--stone)}.cass-igp .eyebrow{color:var(--grain)}.cass-prose .cass-status{font-size:.85rem;color:var(--grain);border-bottom:1px solid #ffffff35;padding-bottom:1rem}.cass-visit-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;margin-top:3rem}.cass-visit-grid article{border-top:1px solid var(--line);padding-top:1.5rem}.cass-visit h3{font-size:1.8rem}.cass-visit p{margin:1rem 0 1.5rem;line-height:1.75;max-width:520px}a:focus-visible{outline:2px solid currentColor;outline-offset:5px}
@media(max-width:800px){.cass-hero-grid,.cass-editorial,.cass-visit-grid{grid-template-columns:1fr;gap:2rem}.cass-hero{padding-top:7rem}.cass-hero h1{font-size:clamp(3.5rem,13vw,6rem)}.cass-steps{grid-template-columns:1fr;gap:1.5rem;margin-block:2rem}.cass-index{gap:.25rem 1.25rem;margin-top:2rem}.cass-prose p{font-size:1rem}.cass-visit-grid{margin-top:2rem}}
  .cass-hero-copy > p:not(.eyebrow), .cass-igp .cass-prose > p:not(.cass-status) { color: #fff; }
  /* Tipografia della hero coerente con le altre pagine editoriali */
  .cass-hero h1 {
    font-size: clamp(4rem, 7vw, 7rem);
    line-height: .96;
  }

  .cass-hero-copy > p:not(.eyebrow) {
    font-family: var(--body);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 490px;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .cass-hero h1 {
      font-size: clamp(3.5rem, 7vw, 5.5rem);
    }
  }

  @media (max-width: 700px) {
    .cass-hero h1 {
      font-size: clamp(3.5rem, 14vw, 5rem);
    }

    .cass-hero-copy > p:not(.eyebrow) {
      font-size: 1rem;
    }
  }
</style>
