---
import Base from '../layouts/Base.astro';
import { cassatellaEvent, getCassatellaEventGraph } from '../data/cassatella-event';
import { getCassatellaVisits } from '../data/cassatella-visits';
import { serializeSchema } from '../lib/schema';
import { imageFile } from '../lib/image-metadata';
import CassatellaMenus from './CassatellaMenus.astro';
import CassatellaPhotoStory from './CassatellaPhotoStory.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import photos from '../data/photos.json';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const localizedPaths = { it: pageUrl('festival', 'it'), en: pageUrl('festival', 'en') };
const visitorInfo = getCassatellaVisits(lang);
const eventGraph = Astro.site?.protocol === 'https:' ? getCassatellaEventGraph(Astro.site, lang) : undefined;
const copy = lang === 'it' ? {
  title: 'Sagra della Cassatella di Agira 2026 | Hello Agira',
  description: 'Sagra della Cassatella e le vie dei sapori: 13–15 novembre 2026 in Piazza Europa ad Agira. Ingresso gratuito e programma completo della 14ª edizione.',
  heroEyebrow: 'AGIRA · SICILIA · UNA TRADIZIONE DA INCONTRARE',
  heroTitle: 'La cassatella\nincontra Agira.',
  heroText: 'La Sagra della Cassatella e le vie dei sapori torna per la 14ª edizione: tre giorni per incontrare il dolce simbolo del paese, tra stand, musica, folklore e street food.',
  heroAction: 'Vai all’edizione 2026',
  imageCaption: 'La teglia al forno',
  storyEyebrow: '01 / IL CUORE DELLA FESTA',
  storyTitle: 'Un dolce, tante storie.',
  storyText: 'La Sagra è l’occasione per incontrare la cassatella nel suo luogo d’origine. Attorno a questo dolce della tradizione agirina si ritrovano la comunità, chi lo prepara e chi arriva per conoscere il paese.',
  storyAside: 'Nelle passate edizioni, il programma ha affiancato agli stand gastronomici musica, spettacoli e momenti dedicati alle tradizioni locali. Ogni anno porta con sé un programma diverso.',
  editionEyebrow: '02 / 14ª EDIZIONE · 2026',
  editionTitle: 'Ci vediamo ad Agira.',
  dateLabel: 'Dal 13 al 15 novembre 2026',
  dateMonth: 'NOVEMBRE',
  dateYear: '2026',
  updateTitle: 'Tre giorni di festa in Piazza Europa.',
  updateText: 'Dal 13 al 15 novembre 2026, Piazza Europa ad Agira ospita la Sagra della Cassatella e le vie dei sapori. Ingresso gratuito, stand, musica dal vivo, folklore, cabaret e attività per bambini.',
  proLoco: 'Aggiornamenti della Pro Loco',
  comune: 'Aggiornamenti del Comune',
  programmeEyebrow: '03 / PROGRAMMA',
  programmeTitle: 'Tre giorni da vivere.',
  planEyebrow: '05 / OLTRE LA SAGRA',
  planTitle: 'Fermati a conoscere Agira.',
  planText: 'Approfitta della Sagra per scoprire la città di Diodoro Siculo: chiese, musei, palazzi, piazze, il Castello medievale e i luoghi di culto di San Filippo d’Agira. Scegli le visite e contatta i referenti per organizzarle.',
  sights: 'Cosa vedere',
  food: 'Dove mangiare',
  nextEyebrow: 'IL VIAGGIO CONTINUA',
  nextTitle: 'Un paese da assaporare, con calma.',
  nextAction: 'Esplora Agira',
} : {
  title: 'Cassatella Festival in Agira 2026 | Hello Agira',
  description: 'Agira’s 14th Cassatella Festival, 13–15 November 2026 in Piazza Europa. Free admission, food stands, music, folklore and the full three-day programme.',
  heroEyebrow: 'AGIRA · SICILY · A TRADITION TO EXPERIENCE',
  heroTitle: 'Cassatella\nmeets Agira.',
  heroText: 'Sagra della Cassatella e le vie dei sapori returns for its 14th edition: three days celebrating Agira’s signature pastry, with stands, music, folklore and street food.',
  heroAction: 'Explore the 2026 edition',
  imageCaption: 'The tray at the oven',
  storyEyebrow: '01 / AT THE HEART OF THE FESTIVAL',
  storyTitle: 'One pastry, many stories.',
  storyText: 'The festival is a chance to discover cassatella in the place it comes from. This local pastry brings together the community, the people who make it and visitors keen to get to know Agira.',
  storyAside: 'Previous editions have paired food stands with music, performances and moments celebrating local traditions. Each year brings a different programme.',
  editionEyebrow: '02 / 14TH EDITION · 2026',
  editionTitle: 'See you in Agira.',
  dateLabel: '13–15 November 2026',
  dateMonth: 'NOVEMBER',
  dateYear: '2026',
  updateTitle: 'Three days of celebration in Piazza Europa.',
  updateText: 'From 13 to 15 November 2026, Piazza Europa in Agira hosts Sagra della Cassatella e le vie dei sapori. Enjoy free admission, food stands, live music, folklore, comedy and children’s activities. For updates and any changes, check the organisers’ channels.',
  proLoco: 'Pro Loco updates',
  comune: 'Municipality updates',
  programmeEyebrow: '03 / PROGRAMME',
  programmeTitle: 'Three days to enjoy.',
  planEyebrow: '05 / BEYOND THE FESTIVAL',
  planTitle: 'Stay and get to know Agira.',
  planText: 'Make the festival a chance to explore the town of Diodorus Siculus: churches, museums, palaces, squares, the medieval castle and places associated with Saint Philip of Agira. Choose your visits and contact the venues to arrange them.',
  sights: 'Things to see',
  food: 'Where to eat',
  nextEyebrow: 'KEEP EXPLORING',
  nextTitle: 'A town to savour, at your own pace.',
  nextAction: 'Explore Agira',
};
const sightsHref = pageUrl('sights', lang);
const foodHref = pageUrl('eat', lang);
const editionFacts = lang === 'it' ? [
  { label: 'QUANDO', value: 'Dal 13 al 15 novembre 2026' },
  { label: 'DOVE', value: 'Piazza Europa, Agira · Sicilia' },
  { label: 'INGRESSO', value: 'Gratuito' },
] : [
  { label: 'WHEN', value: '13–15 November 2026' },
  { label: 'WHERE', value: 'Piazza Europa, Agira · Sicily' },
  { label: 'ADMISSION', value: 'Free' },
];
const programmeDays = [
  {
    date: '2026-11-13',
    label: l('Venerdì 13', 'Friday 13'),
    title: l('Venerdì 13 novembre 2026', 'Friday 13 November 2026'),
    items: [
      { time: '19:00', title: l('Inaugurazione della 14ª Sagra della Cassatella e le vie dei sapori, con esibizione itinerante del Gruppo Folk Trinacria di Agira', 'Opening of the 14th Sagra della Cassatella e le vie dei sapori, with a street performance by Gruppo Folk Trinacria di Agira') },
      { time: '20:30', title: l('Serata musicale con la cantante costaricana Cecilia Gayle', 'An evening of music with Costa Rican singer Cecilia Gayle') },
      { time: '23:00', title: l('DJ set con Cardillo DJ', 'DJ set with Cardillo DJ') },
    ],
  },
  {
    date: '2026-11-14',
    label: l('Sabato 14', 'Saturday 14'),
    title: l('Sabato 14 novembre 2026', 'Saturday 14 November 2026'),
    items: [
      { time: '10:00', title: l('Apertura stand', 'Stands open') },
      { time: '10:00', title: l('Esposizione di auto tuning a cura del Team Easy Sound Tuning Performance', 'Car tuning exhibition by Team Easy Sound Tuning Performance') },
      { time: '11:00', title: l('Spettacolo itinerante con il Gruppo Folk Trinacria di Agira', 'Street performance by Gruppo Folk Trinacria di Agira') },
      { time: '12:00', title: l('Area gastronomica: musica dal vivo con The Moonlight', 'Food area: live music with The Moonlight') },
      { time: '15:00', title: l('Circuito di destrezza per bambini con i go-kart', 'Go-kart skills course for children') },
      { time: '18:00', title: l('Spettacolo itinerante con gli Orkestreet Città di Agira', 'Street performance by Orkestreet Città di Agira') },
      { time: '19:30', title: l('Area gastronomica: DJ set con DJ Cesar e Laura Ayla DJ', 'Food area: DJ set with DJ Cesar and Laura Ayla DJ') },
      { time: '21:00', title: l('Area gastronomica: cabaret con I Falsi d’Autore, presentati da Paola Parsi', 'Food area: comedy show with I Falsi d’Autore, hosted by Paola Parsi') },
      { time: '23:00', title: l('Area gastronomica: DJ set con DJ Cesar e Laura Ayla DJ', 'Food area: DJ set with DJ Cesar and Laura Ayla DJ') },
    ],
  },
  {
    date: '2026-11-15',
    label: l('Domenica 15', 'Sunday 15'),
    title: l('Domenica 15 novembre 2026', 'Sunday 15 November 2026'),
    items: [
      { time: '10:00', title: l('Apertura stand', 'Stands open') },
      { time: '10:00', title: l('Esposizione di auto e moto d’epoca', 'Classic car and motorcycle exhibition') },
      { time: '10:30', title: l('Sfilata con il corteo “Argyrium” di Agira', 'Parade by Agira’s “Argyrium” procession') },
      { time: '12:00', title: l('Area gastronomica: musica dal vivo con Carmelo Ariti (Blue Stratos)', 'Food area: live music with Carmelo Ariti (Blue Stratos)') },
      { time: '15:00', title: l('Circuito di destrezza per bambini con i carri matti “Carruzzuna”', 'Skills course for children with the “Carruzzuna” carts') },
      { time: '17:30', title: l('Esibizione itinerante con il Gruppo Folk Family Dance', 'Street performance by Gruppo Folk Family Dance') },
      { time: '18:30', title: l('Esibizione dell’Accademia Orfei', 'Performance by Accademia Orfei') },
      { time: '20:00', title: l('Area gastronomica: Cartoon Tribute con I Rockanimati', 'Food area: cartoon theme-song tribute with I Rockanimati') },
    ],
  },
];
const festivalArchive = [
  { name: 'cassatellaFestival2025', caption: l('13ª edizione · 2025', '13th edition · 2025') },
  { name: 'cassatellaFestival2024', caption: l('12ª edizione · 2024', '12th edition · 2024') },
  { name: 'cassatellaFestival2023', caption: l('11ª edizione · 2023', '11th edition · 2023') },
  { name: 'cassatellaFestival2022', caption: l('10ª edizione · 2022', '10th edition · 2022') },
] as const;
---

<Base socialPhoto="cassatelleAnello9934" lang={lang} title={copy.title} description={copy.description} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="festival"/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="festival-title">
      <div class="container">
        <p class="eyebrow festival-topline">{copy.heroEyebrow}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <p class="eyebrow">{lang === 'it' ? 'UNA FESTA DI SAPORI E TRADIZIONI' : 'A CELEBRATION OF FLAVOUR AND TRADITION'}</p>
            <h1 id="festival-title">{copy.heroTitle}</h1>
            <p>{copy.heroText}</p>
            <div class="festival-date-lockup" aria-label={copy.dateLabel}>
              <span>{l('14ª EDIZIONE', '14TH EDITION')}</span>
              <div><strong>13–15</strong><p>{copy.dateMonth}<br/>{copy.dateYear}</p></div>
            </div>
            <a class="button button-yellow" href="#edizione-2026">{copy.heroAction}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo">
            <div class="photo-link"><Photo name="cassatelleAnello9934" lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></div>
            <figcaption><span>{copy.imageCaption}</span><span>{photos.cassatelleAnello9934.credit?.[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="festival-story section" aria-labelledby="festival-story-title">
      <div class="container festival-story-grid">
        <div><p class="eyebrow">{copy.storyEyebrow}</p><h2 id="festival-story-title">{copy.storyTitle}</h2></div>
        <div class="festival-story-copy">
          <p>{copy.storyText}</p>
          <p>{copy.storyAside}</p>
          <p><a class="text-link" href={pageUrl('cassatella',lang)}>{lang === 'it' ? 'Scopri la Cassatella di Agira: ingredienti e tradizione' : 'Discover Cassatella di Agira: ingredients and tradition'}<Icon name="arrow"/></a></p>
          <div class="festival-story-gallery" aria-label={lang === 'it' ? 'Locandine delle edizioni passate della Sagra' : 'Posters from past festival editions'}>
            {festivalArchive.map(item => <figure>
              <a href={imageFile(item.name, photos[item.name].width)} target="_blank" rel="noopener noreferrer" aria-label={lang === 'it' ? `Apri la locandina: ${item.caption}` : `Open poster: ${item.caption}`}>
                <Photo name={item.name} lang={lang} sizes="(max-width: 700px) 44vw, 13vw"/>
              </a>
              <figcaption>{item.caption}</figcaption>
            </figure>)}
          </div>
        </div>
      </div>
    </section>

    <CassatellaPhotoStory lang={lang}/>

    <section id="edizione-2026" class="festival-edition" aria-labelledby="festival-edition-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date">
          <p class="eyebrow">{copy.editionEyebrow}</p>
          <h2 id="festival-edition-title">{copy.editionTitle}</h2>
          {editionFacts.map(fact => <div class="festival-date-detail"><span>{fact.label}</span><strong>{fact.value}</strong></div>)}
        </div>
        <div class="festival-programme">
          <span class="festival-programme-index" aria-hidden="true">14</span>
          <h3>{copy.updateTitle}</h3>
          <p>{copy.updateText}</p>
          <p>{l('Ingresso libero, senza prenotazione o biglietto. Anche gli spettacoli sono inclusi; cibo e bevande si acquistano separatamente.', 'Free entry without booking or tickets. Shows are included; food and drinks are purchased separately.')}</p>
          <p>{l('Organizzazione:', 'Organised by:')} <a class="text-link" href={cassatellaEvent.organizer.url} target="_blank" rel="noopener noreferrer">{cassatellaEvent.organizer.name}<Icon name="diagonal"/></a></p>
          <div class="festival-official-links">
            <a class="text-link" href="#menu-della-sagra">{l('I menù della Sagra', 'Festival menus')}<Icon name="arrow"/></a>
            <a class="text-link" href="#visite-e-navetta">{l('Visite, prenotazioni e navetta', 'Visits, bookings and shuttle')}<Icon name="arrow"/></a>
            <a class="text-link" href={cassatellaEvent.location.mapUrl} target="_blank" rel="noopener noreferrer">{l('Come arrivare · Piazza Europa', 'Getting here · Piazza Europa')}<Icon name="diagonal"/></a>
          </div>
        </div>
      </div>
    </section>

    <section id="programma" class="festival-schedule-section section" aria-labelledby="festival-schedule-title">
      <div class="container">
        <div class="festival-schedule-heading">
          <div>
            <p class="eyebrow">{copy.programmeEyebrow}</p>
            <h2 id="festival-schedule-title">{copy.programmeTitle}</h2>
            <nav class="festival-day-links" aria-label={l('Vai al programma della giornata', 'Jump to a day’s programme')}>
              {programmeDays.map(day => <a class="text-link" href={`#programma-${day.date}`}>{day.label}<Icon name="arrow"/></a>)}
            </nav>
          </div>
          <figure class="festival-current-poster">
            <a href="/images/cassatella-festival-2026.webp" target="_blank" rel="noopener noreferrer" aria-label={l('Apri e ingrandisci la locandina della Sagra della Cassatella 2026', 'Open the full-size 2026 Cassatella Festival poster')}>
              <Photo name="cassatellaFestival2026" lang={lang} sizes="(max-width: 700px) 180px, 200px"/>
            </a>
            <figcaption>{l('Locandina 2026 · Ingrandisci', '2026 poster · View full size')}</figcaption>
          </figure>
        </div>
        {programmeDays.map(day => <section class="festival-schedule-day" aria-labelledby={`programma-${day.date}`}>
          <h3 id={`programma-${day.date}`}><time datetime={day.date}>{day.title}</time></h3>
          <ol class="festival-schedule-list">
            {day.items.map(item => <li>
              <time datetime={`${day.date}T${item.time}:00+01:00`}>{item.time}</time>
              <div><h4>{item.title}</h4></div>
            </li>)}
          </ol>
        </section>)}
      </div>
    </section>

    <CassatellaMenus lang={lang}/>

    <section id="visite-e-navetta" class="festival-plan festival-visits section" aria-labelledby="festival-plan-title">
      <div class="container festival-plan-grid">
        <div><p class="eyebrow">{copy.planEyebrow}</p><h2 id="festival-plan-title">{copy.planTitle}</h2></div>
        <div><p>{copy.planText}</p><div class="festival-plan-links"><a class="text-link" href={sightsHref}>{copy.sights}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('beautifulVillages', lang)}>{l('Agira tra i Borghi più belli d’Italia', 'Agira among Italy’s Most Beautiful Villages')}<Icon name="arrow"/></a></div></div>
      </div>
      <div class="container">
        <ul class="festival-visit-list" aria-label={l('Visite e mostra durante la Sagra', 'Visits and exhibition during the festival')}>
          {visitorInfo.visits.map((visit, i) => <li>
            <div class="festival-visit-top"><p>{i === 3 ? l('MOSTRA D’ARTE', 'ART EXHIBITION') : l('VISITE SU PRENOTAZIONE', 'VISITS BY APPOINTMENT')}</p><span class="small-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div>
            <h3>{visit.title}</h3>
            <p>{visit.text}</p>
            <div class="festival-visit-actions">
              <a class="button button-yellow" href={visit.href} aria-label={`${visit.action}: ${visit.title}, ${visit.phone}`}><span>{visit.action}<br/>{visit.phone}</span><Icon name="diagonal"/></a>
              {'detailUrl' in visit && <a class="text-link" href={visit.detailUrl}>{l('Scopri il luogo', 'Explore the place')}<Icon name="arrow"/></a>}
            </div>
          </li>)}
        </ul>
        <section class="festival-shuttle" aria-labelledby="festival-shuttle-title">
          <div><p class="eyebrow">{l('MUOVERSI DURANTE LA SAGRA', 'GETTING AROUND DURING THE FESTIVAL')}</p><h3 id="festival-shuttle-title">{l('Il servizio navetta.', 'The shuttle service.')}</h3><p>{l('A cura di', 'Provided by')} {visitorInfo.shuttle.organizer}.</p></div>
          <div><p><strong>{l('Punto di partenza:', 'Departure point:')}</strong><br/>{visitorInfo.shuttle.departure}</p><a class="button button-yellow" href={visitorInfo.shuttle.href} aria-label={`${l('Informazioni sul servizio navetta', 'Shuttle service information')}: ${visitorInfo.shuttle.phone}`}><span>{l('Informazioni', 'Information')} · {visitorInfo.shuttle.phone}</span><Icon name="diagonal"/></a></div>
        </section>
      </div>
    </section>

    <section class="itinerary-next festival-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{copy.nextEyebrow}</p><h2>{copy.nextTitle}</h2></div>
        <div class="itinerary-next-links"><a class="button button-yellow" href={foodHref}>{copy.food}<Icon name="arrow"/></a></div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="festival"/>
  {eventGraph && <script type="application/ld+json" set:html={serializeSchema(eventGraph)}/>}
</Base>

<style>
  .festival-visits .festival-plan-grid{align-items:start}
  .festival-visit-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:3rem 0 0;padding:0}
  .festival-visit-list>li{display:flex;flex-direction:column;min-width:0;background:var(--white);border:1px solid var(--line);border-top:3px solid var(--forest);border-radius:2px;padding:1.8rem}
  .festival-visit-top{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}
  .festival-visit-top p{font-size:.75rem;line-height:1.5;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
  .festival-visit-top .small-number{flex-shrink:0}
  .festival-visit-list h3,.festival-shuttle h3{font-size:clamp(1.6rem,2.5vw,2rem);line-height:1.15;letter-spacing:-.04em;margin:0 0 1.3rem;overflow-wrap:anywhere}
  .festival-visit-list p,.festival-shuttle p{line-height:1.65}
  .festival-visit-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem;margin-top:auto;padding-top:1.5rem}
  .festival-visit-actions .button,.festival-shuttle .button{font-size:.875rem;min-height:48px;padding:.8rem 1.2rem;gap:1rem;max-width:100%;white-space:normal;text-align:left}
  .festival-visit-actions .button svg,.festival-shuttle .button svg{width:18px;height:18px;flex-shrink:0}
  .festival-visit-actions .text-link{font-size:.875rem}
  .festival-visit-actions .button span,.festival-shuttle .button span{line-height:1.6;overflow-wrap:anywhere}
  .festival-shuttle{display:grid;grid-template-columns:1.1fr .9fr;gap:3rem;background:var(--white);border:1px solid var(--line);border-top:3px solid var(--forest);border-radius:2px;padding:1.8rem;margin-top:1.5rem}
  .festival-shuttle .eyebrow{margin-bottom:1.2rem}
  .festival-shuttle .button{margin-top:1.3rem}
  @media(max-width:700px){.festival-visit-list,.festival-shuttle{grid-template-columns:1fr;gap:1rem}.festival-visit-list{margin-top:2rem}.festival-visit-list>li,.festival-shuttle{padding:1.5rem 1.3rem}.festival-shuttle>div+div{margin-top:.3rem}}

  .festival-story-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.85rem;margin-top:1.65rem}
  .festival-story-gallery figure{min-width:0;margin:0}
  .festival-story-gallery a{display:block;overflow:hidden;border:1px solid #d8d4c8;border-radius:4px;background:#fff;box-shadow:0 5px 16px #14251d12;transition:transform .2s ease,box-shadow .2s ease}
  .festival-story-gallery a:hover{transform:translateY(-3px);box-shadow:0 9px 22px #14251d20}
  .festival-story-gallery a:focus-visible{outline:3px solid var(--forest);outline-offset:3px}
  .festival-story-gallery :global(img){display:block;width:100%;height:auto}
  .festival-story-gallery figcaption{margin-top:.5rem;color:var(--forest);font-family:var(--display);font-size:.76rem;line-height:1.3;letter-spacing:.01em}
  .festival-schedule-section{background:#073e38;color:var(--stone)}
  .festival-date-lockup strong{font-size:clamp(3.1rem,7vw,4.5rem);white-space:nowrap}
  .festival-schedule-section .eyebrow{color:var(--grain)}
  .festival-schedule-heading{display:grid;grid-template-columns:minmax(0,1fr) 200px;gap:3rem;align-items:center}
  .festival-schedule-heading h2{max-width:720px;margin-top:.85rem;font-size:clamp(3rem,6vw,5.8rem);line-height:.94;letter-spacing:-.07em}
  .festival-day-links{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;margin-top:1.75rem}
  .festival-day-links a{display:inline-flex;align-items:center;gap:.5rem;color:var(--grain)}
  .festival-day-links svg{width:16px;height:16px}
  .festival-current-poster{width:200px;margin:0}
  .festival-current-poster a{display:block;border-radius:4px;overflow:hidden}
  .festival-current-poster a:focus-visible{outline:3px solid var(--grain);outline-offset:4px}
  .festival-current-poster :global(img){display:block;width:100%;height:auto}
  .festival-current-poster figcaption{margin-top:.6rem;font-size:.78rem;line-height:1.4;color:#d8e0d9}
  .festival-schedule-day{margin-top:3.5rem}
