---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import photos from '../data/photos.json';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const localizedPaths = { it: pageUrl('festival', 'it'), en: pageUrl('festival', 'en') };
const copy = lang === 'it' ? {
  title: 'Sagra della Cassatella di Agira 2026 | Hello Agira',
  description: 'La Sagra della Cassatella torna ad Agira domenica 8 novembre 2026. Scopri il programma e organizza la visita.',
  heroEyebrow: 'AGIRA · SICILIA · UNA TRADIZIONE DA INCONTRARE',
  heroTitle: 'La cassatella\nincontra Agira.',
  heroText: 'Ogni anno, la Sagra mette al centro il dolce simbolo del paese e invita a scoprire Agira attraverso sapori, storie e momenti da condividere.',
  heroAction: 'Vai all’edizione 2026',
  imageCaption: 'La cassatella di Agira',
  storyEyebrow: '01 / IL CUORE DELLA FESTA',
  storyTitle: 'Un dolce, tante storie.',
  storyText: 'La Sagra è l’occasione per incontrare la cassatella nel suo luogo d’origine. Attorno a questo dolce della tradizione agirina si ritrovano la comunità, chi lo prepara e chi arriva per conoscere il paese.',
  storyAside: 'Nelle passate edizioni, il programma ha affiancato agli stand gastronomici musica, spettacoli e momenti dedicati alle tradizioni locali. Ogni anno porta con sé un programma diverso.',
  editionEyebrow: '02 / EDIZIONE 2026',
  editionTitle: 'Ci vediamo ad Agira.',
  dateWeekday: 'DOMENICA',
  dateMonth: 'NOVEMBRE',
  dateYear: '2026',
  programmeEyebrow: '03 / PROGRAMMA',
  programmeTitle: 'Dalla mattina fino a sera.',
  programmeUpdates: 'Per eventuali aggiornamenti, consulta i canali ufficiali della Pro Loco e del Comune.',
  proLoco: 'Aggiornamenti della Pro Loco',
  comune: 'Aggiornamenti del Comune',
  planEyebrow: '04 / OLTRE LA SAGRA',
  planTitle: 'Fermati a conoscere Agira.',
  planText: 'La giornata può diventare l’inizio di una visita tra vicoli, luoghi di memoria e sapori del territorio.',
  sights: 'Cosa vedere',
  food: 'Dove mangiare',
  nextEyebrow: 'IL VIAGGIO CONTINUA',
  nextTitle: 'Un paese da assaporare, con calma.',
  nextAction: 'Esplora Agira',
} : {
  title: 'Cassatella Festival in Agira 2026 | Hello Agira',
  description: 'The Cassatella Festival returns to Agira on Sunday 8 November 2026. Explore the programme and plan your visit.',
  heroEyebrow: 'AGIRA · SICILY · A TRADITION TO EXPERIENCE',
  heroTitle: 'Cassatella\nmeets Agira.',
  heroText: 'Each year, the festival celebrates the town’s signature pastry and invites visitors to discover Agira through its flavours, stories and shared moments.',
  heroAction: 'Explore the 2026 edition',
  imageCaption: 'Cassatella di Agira',
  storyEyebrow: '01 / AT THE HEART OF THE FESTIVAL',
  storyTitle: 'One pastry, many stories.',
  storyText: 'The festival is a chance to discover cassatella in the place it comes from. This local pastry brings together the community, the people who make it and visitors keen to get to know Agira.',
  storyAside: 'Previous editions have paired food stands with music, performances and moments celebrating local traditions. Each year brings a different programme.',
  editionEyebrow: '02 / 2026 EDITION',
  editionTitle: 'See you in Agira.',
  dateWeekday: 'SUNDAY',
  dateMonth: 'NOVEMBER',
  dateYear: '2026',
  programmeEyebrow: '03 / PROGRAMME',
  programmeTitle: 'From morning into the night.',
  programmeUpdates: 'For updates, check the official Pro Loco and Municipality channels.',
  proLoco: 'Pro Loco updates',
  comune: 'Municipality updates',
  planEyebrow: '04 / BEYOND THE FESTIVAL',
  planTitle: 'Stay and get to know Agira.',
  planText: 'Make the day the start of a visit among the town’s lanes, places of memory and local flavours.',
  sights: 'Things to see',
  food: 'Where to eat',
  nextEyebrow: 'KEEP EXPLORING',
  nextTitle: 'A town to savour, at your own pace.',
  nextAction: 'Explore Agira',
};
const sightsHref = pageUrl('sights', lang);
const foodHref = pageUrl('eat', lang);
const homeHref = `/${lang}/`;
const prolocoHref = 'https://www.prolocoagira.it/wp/category/sagra-cassatella/';
const comuneHref = 'https://www.comune.agira.en.it/index.php/it/news?type=1';
const editionFacts = lang === 'it' ? [
  { label: 'QUANDO', value: 'Domenica 8 novembre 2026' },
  { label: 'QUANDO', value: 'Ora: 10:00 - 24:00' },
  { label: 'DOVE', value: 'Piazza Europa, Agira · Sicilia' },
  { label: 'COSTO', value: 'Gratuito' },
] : [
  { label: 'WHEN', value: 'Sunday 8 November 2026' },
  { label: 'WHEN', value: 'Time: 10:00–24:00' },
  { label: 'WHERE', value: 'Piazza Europa, Agira · Sicily' },
  { label: 'COST', value: 'Free admission' },
];
const programmeItems = lang === 'it' ? [
  { time: '10:00', title: 'Apertura stand gastronomici' },
  { time: '11:00', title: 'Show cooking', detail: 'A cura di ERIS Formazione Agira.' },
  { time: '12:00', title: 'Area gastronomica', detail: 'Musica dal vivo con Carmelo Ariti (Blue Stratos).' },
  { time: '15:00', title: 'Circuito di destrezza per bambini con i go-kart', detail: 'A cura dell’Associazione San Filippo di Agira e dei commercianti di via Vittorio Emanuele.' },
  { time: '18:00', title: 'Spettacolo itinerante', detail: 'A cura di Blue Stars Street Band.' },
  { time: '21:00', title: 'Area gastronomica', detail: 'Musica dal vivo con la cover band Maneskin Pink Tribute.' },
  { time: '23:00', title: 'DJ set', detail: 'Con DJ Cesar e Laura Ayla DJ.' },
] : [
  { time: '10:00', title: 'Food stands open' },
  { time: '11:00', title: 'Live cooking demonstration', detail: 'By ERIS Formazione Agira.' },
  { time: '12:00', title: 'Food area', detail: 'Live music with Carmelo Ariti (Blue Stratos).' },
  { time: '15:00', title: 'Go-kart skills course for children', detail: 'Organised by the San Filippo Association of Agira and the shopkeepers of Via Vittorio Emanuele.' },
  { time: '18:00', title: 'Street performance', detail: 'By Blue Stars Street Band.' },
  { time: '21:00', title: 'Food area', detail: 'Live music with the Maneskin Pink Tribute cover band.' },
  { time: '23:00', title: 'DJ set', detail: 'With DJs Cesar and Laura Ayla.' },
];
---

<Base lang={lang} title={copy.title} description={copy.description} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="festival"/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="festival-title">
      <div class="container">
        <p class="eyebrow festival-topline">{copy.heroEyebrow}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <p class="eyebrow">{lang === 'it' ? 'UNA FESTA DI SAPORI E TRADIZIONI' : 'A CELEBRATION OF FLAVOUR AND TRADITION'}</p>
            <h1 id="festival-title">{copy.heroTitle}</h1>
            <p>{copy.heroText}</p>
            <div class="festival-date-lockup" aria-label={`${copy.dateWeekday} 8 ${copy.dateMonth} ${copy.dateYear}`}>
              <span>{lang === 'it' ? 'EDIZIONE IN EVIDENZA' : 'FEATURED EDITION'}</span>
              <div><strong>08</strong><p>{copy.dateMonth}<br/>{copy.dateYear}</p></div>
            </div>
            <a class="button button-yellow" href="#edizione-2026">{copy.heroAction}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo">
            <div class="photo-link"><Photo name="pastry" lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></div>
            <figcaption><span>{copy.imageCaption}</span><span>{photos.pastry.credit?.[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="festival-story section" aria-labelledby="festival-story-title">
      <div class="container festival-story-grid">
        <div><p class="eyebrow">{copy.storyEyebrow}</p><h2 id="festival-story-title">{copy.storyTitle}</h2></div>
        <div class="festival-story-copy"><p>{copy.storyText}</p><p>{copy.storyAside}</p></div>
      </div>
    </section>

    <section id="edizione-2026" class="festival-edition" aria-labelledby="festival-edition-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date">
          <p class="eyebrow">{copy.editionEyebrow}</p>
          <h2 id="festival-edition-title">{copy.editionTitle}</h2>
        </div>
        <dl class="festival-edition-facts">
          {editionFacts.map(fact => <div class="festival-edition-fact"><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section id="programma" class="festival-schedule-section section" aria-labelledby="festival-schedule-title">
      <div class="container">
        <div class="festival-schedule-heading">
          <p class="eyebrow">{copy.programmeEyebrow}</p>
          <h2 id="festival-schedule-title">{copy.programmeTitle}</h2>
        </div>
        <ol class="festival-schedule-list">
          {programmeItems.map(item => <li>
            <time datetime={item.time}>{item.time}</time>
            <div><h3>{item.title}</h3>{item.detail && <p>{item.detail}</p>}</div>
          </li>)}
        </ol>
        <div class="festival-schedule-footer">
          <p>{copy.programmeUpdates}</p>
          <div class="festival-official-links">
            <a class="text-link" href={prolocoHref} target="_blank" rel="noopener noreferrer">{copy.proLoco}<Icon name="diagonal"/></a>
            <a class="text-link" href={comuneHref} target="_blank" rel="noopener noreferrer">{copy.comune}<Icon name="diagonal"/></a>
          </div>
        </div>
      </div>
    </section>

    <section class="festival-plan section" aria-labelledby="festival-plan-title">
      <div class="container festival-plan-grid">
        <div><p class="eyebrow">{copy.planEyebrow}</p><h2 id="festival-plan-title">{copy.planTitle}</h2></div>
        <div><p>{copy.planText}</p><div class="festival-plan-links"><a class="text-link" href={sightsHref}>{copy.sights}<Icon name="arrow"/></a><a class="text-link" href={foodHref}>{copy.food}<Icon name="arrow"/></a></div></div>
      </div>
    </section>

    <section class="itinerary-next festival-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{copy.nextEyebrow}</p><h2>{copy.nextTitle}</h2></div>
        <div class="itinerary-next-links"><a class="button button-yellow" href={homeHref}>{copy.nextAction}<Icon name="arrow"/></a></div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="festival"/>
</Base>

<style>
  .festival-edition-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2rem;align-content:center;margin:0}
  .festival-edition-fact{display:grid;gap:.55rem;padding:1.15rem 0;border-top:1px solid #aab7a9}
  .festival-edition-fact dt{font-size:.68rem;letter-spacing:.1em;color:var(--muted)}
  .festival-edition-fact dd{margin:0;font-size:.96rem;line-height:1.5;font-weight:500}
  .festival-schedule-section{background:#073e38;color:var(--stone)}
  .festival-schedule-section .eyebrow{color:var(--grain)}
  .festival-schedule-heading{max-width:760px}
  .festival-schedule-heading h2{max-width:720px;margin-top:.85rem;font-size:clamp(3rem,6vw,5.8rem);line-height:.94;letter-spacing:-.07em}
  .festival-schedule-list{list-style:none;margin:3rem 0 0;padding:0}
  .festival-schedule-list li{display:grid;grid-template-columns:8rem minmax(0,1fr);gap:1.5rem;padding:1.3rem 0;border-top:1px solid #ffffff35}
  .festival-schedule-list li:last-child{border-bottom:1px solid #ffffff35}
  .festival-schedule-list time{font-family:var(--display);font-size:2rem;line-height:1;color:var(--grain);letter-spacing:-.05em}
  .festival-schedule-list h3{font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.25;letter-spacing:-.025em}
  .festival-schedule-list p{max-width:760px;margin-top:.35rem;font-size:.9rem;line-height:1.6;color:#d8e0d9}
  .festival-schedule-footer{display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:center;margin-top:2rem}
  .festival-schedule-footer>p{max-width:520px;font-size:.82rem;line-height:1.55;color:#d8e0d9}
  @media(max-width:700px){
    .festival-edition-facts{grid-template-columns:1fr}
    .festival-schedule-list{margin-top:2rem}
    .festival-schedule-list li{grid-template-columns:5rem minmax(0,1fr);gap:.85rem;padding:1.1rem 0}
    .festival-schedule-list time{font-size:1.55rem}
    .festival-schedule-footer{grid-template-columns:1fr;gap:.4rem}
  }
</style>
