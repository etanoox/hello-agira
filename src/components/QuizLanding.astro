---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './Icon.astro';
import { quizQuestions } from '../data/quiz';
import { pageUrl, type Locale } from '../lib/i18n';
import '../styles/itineraries.css';
import '../styles/quiz.css';
interface Props { lang: Locale }
const { lang } = Astro.props;
const it = lang === 'it';
const paths = { it: pageUrl('quiz', 'it'), en: pageUrl('quiz', 'en') };
const questionData = JSON.stringify(quizQuestions).replace(/</g, '\\u003c');
---
<Base lang={lang} title={it ? 'Quanto conosci Agira? Il quiz | Hello Agira' : 'How well do you know Agira? The quiz | Hello Agira'} description={it ? 'Metti alla prova la tua curiosità: 10 domande casuali su Agira, la sua storia, i luoghi e i sapori. Gioca gratis, senza timer.' : 'Discover the Hello Agira quiz: ten random questions about the town, its history, places and flavours. Currently available in Italian.'} canonicalPath={paths[lang]} alternatePaths={paths}>
  <div class="itinerary-detail-shell">
  <SiteHeader lang={lang} alternatePaths={paths}/>
  <main id="main" tabindex="-1" class="quiz-page">
    <section class="quiz-layout container" aria-labelledby="quiz-title">
      <div class="quiz-intro">
        <p class="eyebrow">{it ? 'GIOCA. SCOPRI. RICOMINCIA.' : 'PLAY. DISCOVER. TRY AGAIN.'}</p>
        <h1 id="quiz-title">{it ? 'Quanto conosci' : 'How well do you know'} <span>Agira?</span></h1>
        <p class="quiz-lead">{it ? 'Luoghi, sapori e storie. Dieci domande per guardare il paese con occhi nuovi.' : 'Places, flavours and stories. Ten questions to see the town through fresh eyes.'}</p>
        <div class="quiz-intro-note"><span aria-hidden="true">10</span><p>{it ? 'Domande per partita. Nessuna fretta: il tempo di scoprire è tutto tuo.' : 'Questions per game. Take your time: discovering is part of the fun.'}</p></div>
        <a class="text-link" href={pageUrl('sights', lang)}>{it ? 'Continua a scoprire Agira' : 'Keep discovering Agira'}<Icon name="diagonal"/></a>
      </div>
      {it ? <div class="quiz-game" data-quiz>
        <section class="quiz-card quiz-welcome" data-quiz-welcome aria-labelledby="quiz-welcome-title">
          <p class="eyebrow">LA CURIOSITÀ È IL PUNTO DI PARTENZA</p>
          <h2 id="quiz-welcome-title">Una domanda.<br/>Una scoperta.</h2>
          <p>Ogni partita è un percorso diverso tra le storie di Agira. Scegli una risposta e scopri subito quella corretta.</p>
          <ul class="quiz-rules"><li>10 domande estratte a caso</li><li>4 risposte tra cui scegliere</li><li>Nessun timer, nessuna registrazione</li></ul>
          <button class="button button-yellow" type="button" data-quiz-start hidden>Cominciamo<Icon name="arrow"/></button>
          <p class="quiz-bank-note">{quizQuestions.length} domande da cui partire. Quante ne conosci?</p>
          <noscript><p class="quiz-feedback">Per giocare, attiva JavaScript nel browser. Puoi comunque esplorare <a href={pageUrl('sights', lang)}>i luoghi di Agira</a>.</p></noscript>
        </section>
        <section class="quiz-card" data-quiz-play hidden aria-label="La tua partita">
          <div class="quiz-game-top"><p class="quiz-counter" data-quiz-counter></p><p class="quiz-score">Corrette <strong data-quiz-score>0</strong></p></div>
          <progress class="quiz-progress" data-quiz-progress max="10" value="0" aria-label="Domande completate">0 su 10</progress>
          <p class="eyebrow quiz-category" data-quiz-category></p>
          <h2 class="quiz-question" data-quiz-question tabindex="-1"></h2>
          <div class="quiz-answers" data-quiz-answers role="group" aria-label="Scegli una risposta" aria-describedby="quiz-answer-instructions"></div>
          <p class="quiz-instructions" id="quiz-answer-instructions">Scegli una risposta. Dopo la scelta non potrai cambiarla.</p>
          <div class="quiz-feedback" data-quiz-feedback role="status" aria-live="polite" aria-atomic="true"></div>
          <button class="button button-green quiz-next" type="button" data-quiz-next hidden>Continua<Icon name="arrow"/></button>
        </section>
        <section class="quiz-card quiz-result" data-quiz-result hidden aria-labelledby="quiz-result-title">
          <p class="eyebrow">IL TUO PERCORSO, IN DIECI RISPOSTE</p>
          <p class="quiz-result-score"><strong data-quiz-total>0</strong><span>/ 10</span></p>
          <h2 id="quiz-result-title" data-quiz-result-title tabindex="-1"></h2>
          <p data-quiz-result-message></p>
          <button class="button button-yellow" type="button" data-quiz-restart>Gioca ancora<Icon name="arrow"/></button>
          <details class="quiz-review"><summary>Rivedi le tue risposte<Icon name="plus"/></summary><ol data-quiz-review></ol></details>
          <a class="text-link" href={pageUrl('history', lang)}>Le storie continuano qui<Icon name="diagonal"/></a>
        </section>
        <script type="application/json" data-quiz-data set:html={questionData}/>
      </div> : <section class="quiz-card quiz-welcome" aria-labelledby="quiz-language-title">
        <p class="eyebrow">THE HELLO AGIRA QUIZ</p>
        <h2 id="quiz-language-title">A little curiosity.<br/>A new discovery.</h2>
        <p>The quiz questions are currently available in Italian. You can play the full game in Italian, or explore our English guide while we prepare the translations.</p>
        <a class="button button-yellow" href={paths.it} lang="it">Gioca in italiano<Icon name="arrow"/></a>
        <a class="text-link" href={pageUrl('history', lang)}>Explore Agira’s history<Icon name="diagonal"/></a>
      </section>}
    </section>
  </main>
  <SiteFooter lang={lang} alternatePaths={paths}/>
  </div>
  <script>import '../scripts/quiz';</script>
</Base>
