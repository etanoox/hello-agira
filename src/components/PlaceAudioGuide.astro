---
const audioFiles = import.meta.glob('/public/audio/**/*', { query: '?url', import: 'default' });
import type { PlaceAudioGuide, AudioTrack } from '../data/sight-pages';
import type { Locale } from '../lib/i18n';
interface Props { guide: PlaceAudioGuide; lang: Locale; id?: string }
const { guide, lang, id = 'audioguida' } = Astro.props;
const l = (it: string,en: string) => lang === 'it' ? it : en;
if (!guide.chapters.length) throw new Error('An audio guide needs at least one chapter. Omit audio when unavailable.');
for (const track of [...guide.chapters, ...(guide.full ? [guide.full] : [])]) {
  if (!/^\/audio\/[a-zA-Z0-9/_-]+\.(mp3|m4a|ogg|wav)$/.test(track.src) || !(`/public${track.src}` in audioFiles)) {
    throw new Error(`Missing or invalid local audio file: ${track.src}`);
  }
  if (track.durationSeconds !== undefined && (!Number.isFinite(track.durationSeconds) || track.durationSeconds <= 0)) throw new Error('Audio duration must be positive.');
}
if (guide.chapters.some(chapter=>!chapter.title.trim())) throw new Error('Audio chapters need a title.');
const format = (track: AudioTrack) => track.durationSeconds === undefined ? '' : `${Math.floor(track.durationSeconds/60)}:${String(Math.floor(track.durationSeconds%60)).padStart(2,'0')}`;
---
<section id={id} class="place-audio" data-audio-guide data-lang={lang} aria-labelledby={`${id}-title`}>
  <div class="place-audio-heading"><p class="eyebrow">{l('ASCOLTA IL LUOGO', 'LISTEN TO THIS PLACE')}</p><h2 id={`${id}-title`}>{guide.title}</h2><p>{guide.introduction}</p><span class="place-audio-language">{(guide.language ?? lang) === 'en' ? l('Audio in inglese', 'Audio in English') : l('Audio in italiano', 'Audio in Italian')} · {guide.chapters.length} {l('capitoli', 'chapters')}</span></div>
  <div class="place-audio-player">
    <p data-current-track>{guide.chapters[0].title}</p>
    <audio controls preload="none" src={guide.chapters[0].src} aria-label={guide.title} data-audio-player>
      <a href={guide.chapters[0].src}>{l('Apri il primo capitolo audio', 'Open the first audio chapter')}</a>
    </audio>
    <div class="place-audio-tools" data-audio-tools hidden>
      <button type="button" data-audio-start>{l('Ascolta dall’inizio', 'Play from the beginning')}</button>
      <button type="button" data-audio-prev disabled>{l('Precedente', 'Previous')}</button>
      <button type="button" data-audio-next disabled={guide.chapters.length < 2}>{l('Successivo', 'Next')}</button>
      <label>{l('Velocità', 'Speed')} <select data-audio-speed aria-label={l('Velocità di riproduzione', 'Playback speed')}><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option></select></label>
    </div>
    {guide.full && <a class="text-link" href={guide.full.src} data-audio-full data-title={l('Guida completa', 'Full guide')}>{l('Guida completa in un unico audio', 'Full guide in one recording')} {format(guide.full)}</a>}
    <p class="place-audio-status" data-audio-status role="status" aria-live="polite"></p>
  </div>
  <ol class="place-audio-chapters" aria-label={l('Capitoli audio', 'Audio chapters')}>
    {guide.chapters.map((chapter,index)=><li><span class="place-chapter-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{chapter.title}</h3>{chapter.transcript.some(text=>text.trim()) && <details lang={guide.language ?? lang} id={`${id}-transcript-${index}`}><summary>{l('Leggi la trascrizione', 'Read the transcript')}</summary>{chapter.transcript.map(text=><p>{text}</p>)}</details>}</div><a href={chapter.src} data-audio-chapter data-title={chapter.title} aria-label={`${l('Ascolta', 'Listen to')}: ${chapter.title}`}><span aria-hidden="true">▷</span> {l('Ascolta', 'Listen')} {format(chapter)}</a></li>)}
  </ol>
  {guide.credit && <p class="place-audio-credit">{guide.credit}</p>}
  <script>import '../scripts/place-audio';</script>
</section>
