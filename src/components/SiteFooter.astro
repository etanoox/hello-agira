---
import Icon from './Icon.astro';
import { socialProfiles } from '../data/social';
import { getCopy } from '../data/copy';
import { anchor, homeUrl, pageUrl, sectionIds, type Locale, type Section } from '../lib/i18n';
interface Props { lang: Locale; currentPage?: 'services' | 'routes' | 'sights' | 'eat' | 'stay' | 'history' | 'festival' | 'events'; alternatePaths?: Record<Locale, string> }
const { lang, currentPage, alternatePaths } = Astro.props;
const c = getCopy(lang);
const navKeys: Section[] = ['sights', 'eat', 'stay', 'routes', 'events', 'history'];
const target = (key: Section) => key === 'routes' || key === 'sights' || key === 'eat' || key === 'stay' || key === 'history' || key === 'events' ? pageUrl(key, lang) : `${homeUrl(lang)}${anchor(key, lang)}`;
const localeTarget = (locale: Locale) => alternatePaths?.[locale] ?? (currentPage ? pageUrl(currentPage, locale) : homeUrl(locale));
---
<footer class="site-footer" id={sectionIds.about[lang]}><div class="container">
  <div class="footer-top">
    <div><a class="wordmark footer-logo" href={homeUrl(lang)}>hello agira<span>.</span></a><p class="footer-title">{c.footerLine}</p><p class="footer-about">{c.footerAbout}</p>
      <nav class="footer-social" aria-label={lang === 'it' ? 'Seguici sui social' : 'Follow us on social media'}>
        <p class="eyebrow">{lang === 'it' ? 'Seguici' : 'Follow us'}</p>
        <div>{socialProfiles.map(profile => <a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.name}<Icon name="diagonal"/></a>)}</div>
      </nav>
    </div>
    <div class="footer-nav"><p class="eyebrow">{c.footerExplore}</p>{navKeys.slice(0,5).map((key,i)=><a href={target(key)}>{c.nav[i]}</a>)}</div>
    <div class="footer-nav"><p class="eyebrow">{c.footerUseful}</p><a href={pageUrl('services',lang)}>{lang === 'it' ? 'Servizi utili' : 'Useful services'}</a><a href={pageUrl('stay',lang)}>{c.plan}</a><a href={`${homeUrl(lang)}${anchor('map',lang)}`}>{c.onMap}</a><a href={pageUrl('thanks',lang)}>{lang === 'it' ? 'Ringraziamenti' : 'Acknowledgements'}</a><a href={pageUrl('legal',lang)}>{lang === 'it' ? 'Note legali e condizioni d’uso' : 'Legal notice and terms of use'}</a><nav class="footer-language" aria-label={lang === 'it' ? 'Lingua del sito' : 'Site language'}><a href={localeTarget('it')} lang="it" hreflang="it" aria-current={lang === 'it' ? 'page' : undefined}>Italiano</a><a href={localeTarget('en')} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>English</a></nav></div>
  </div>
  <div class="footer-bottom"><p> {c.footerDisclaimer.split('Giuseppe Ricceri')[0]} <a href="https://etanoox.me/">Giuseppe Ricceri</a> {c.footerDisclaimer.split('Giuseppe Ricceri')[1]} </p><a href="#top">{c.backTop}<Icon name="diagonal"/></a></div>
</div></footer>

<style>
  .footer-social { margin-top: 1.5rem; }
  .footer-social .eyebrow { color: #b5c6b8; font-size: .75rem; }
  .footer-social > div { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: .4rem; }
  .footer-social a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; font-size: .9375rem; }
  .footer-social a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer-social a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .footer-social :global(svg) { width: 16px; height: 16px; }
</style>
