---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './Icon.astro';
import { getLegal } from '../data/legal';
import { homeUrl, pageUrl, type Locale } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getLegal(lang);
const paths = { it: pageUrl('legal', 'it'), en: pageUrl('legal', 'en') };
---
<Base lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero" aria-labelledby="legal-title"><div class="container route-page-copy">
      <p class="eyebrow">HELLO AGIRA · {l('IL PROGETTO', 'THE PROJECT')}</p><h1 id="legal-title">{c.heading}</h1><p>{c.updated}</p>
    </div></section>
    <section class="festival-story section" aria-labelledby="legal-intro-title"><div class="container festival-story-grid">
      <div><p class="eyebrow">{l('IL GESTORE', 'THE WEBSITE OPERATOR')}</p><h2 id="legal-intro-title">Hello Agira.</h2></div>
      <div class="festival-story-copy"><p>{c.introduction}</p><p>{c.contact} <a class="text-link" href="mailto:helloagira@gmail.com">helloagira@gmail.com</a>.</p></div>
    </div></section>
    {c.sections.map((section, index) => <section id={section.id} class={index % 2 === 0 ? 'festival-plan festival-edition section' : 'festival-story section'} aria-labelledby={`${section.id}-title`}>
      <div class="container festival-story-grid"><div><h2 id={`${section.id}-title`}>{section.title}</h2></div><div class="festival-story-copy">{section.paragraphs.map(text => <p>{text}</p>)}</div></div>
    </section>)}
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner">
      <div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Continua a scoprire Agira.', 'Keep discovering Agira.')}</h2></div>
      <div class="itinerary-next-links"><a class="button button-yellow" href={homeUrl(lang)}>{l('Torna alla home', 'Back to home')}<Icon name="arrow"/></a></div>
    </div></section>
  </main>
  <SiteFooter lang={lang} alternatePaths={paths}/>
</Base>
