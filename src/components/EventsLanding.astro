---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import photos from '../data/photos.json';
import { pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const localizedPaths = { it: pageUrl('events', 'it'), en: pageUrl('events', 'en') };
const copy = lang === 'it' ? {
  title: 'Eventi e tradizioni ad Agira | Hello Agira',
  description: 'Eventi ad Agira: Sagra della Cassatella domenica 15 novembre 2026, dalle 10:00 alle 24:00 in Piazza Europa, festa di San Filippo, Presepe Vivente, Un Pane per la Vita e Motor Expo.',
  eyebrow: 'AGIRA · IL CALENDARIO DELLE TRADIZIONI',
  heading: 'Ci sono giorni\nche restano.',
  intro: 'Le feste raccontano un paese in un modo diverso: attraverso i sapori, i riti e il piacere di ritrovarsi.',
  action: 'Scopri gli appuntamenti',
  calendarEyebrow: 'IN CALENDARIO',
  calendarTitle: 'Un’occasione per venire ad Agira.',
  calendarIntro: 'La Sagra della Cassatella ti aspetta domenica 15 novembre 2026, dalle 10:00 alle 24:00, in Piazza Europa ad Agira.',
  festivalEyebrow: '01 / SAPORI E TRADIZIONI',
  festivalTitle: 'La Sagra della Cassatella.',
  festivalText: 'La festa celebra il dolce simbolo di Agira e invita a scoprire il paese attraverso i suoi sapori e le sue tradizioni.',
  festivalAction: 'Vai alla pagina della Sagra',
  traditionsEyebrow: '02 / FEDE E TRADIZIONE',
  saintTitle: 'La festa di San Filippo.',
  saintText: 'Il 12 maggio Agira celebra San Filippo, patrono del paese. La prossima festa sarà il 12 maggio 2027. La ricorrenza estiva è dedicata soprattutto agli emigrati che tornano ad Agira.',
  saintAction: 'Scopri la festa di San Filippo',
  nextEyebrow: 'IL VIAGGIO CONTINUA',
  nextTitle: 'Una festa è anche un buon motivo per fermarsi.',
  sights: 'Cosa vedere',
  food: 'Dove mangiare',
} : {
  title: 'Events and traditions in Agira | Hello Agira',
  description: 'Events in Agira: the Cassatella Festival on Sunday 15 November 2026, from 10:00 to midnight in Piazza Europa, the feast of Saint Philip, the Living Nativity, Un Pane per la Vita and Motor Expo.',
  eyebrow: 'AGIRA · A CALENDAR OF TRADITIONS',
  heading: 'Some days\nstay with you.',
  intro: 'Festivals tell the story of a place in a different way: through its flavours, rituals and the joy of coming together.',
  action: 'Explore the calendar',
  calendarEyebrow: 'ON THE CALENDAR',
  calendarTitle: 'A reason to come to Agira.',
  calendarIntro: 'Join the Cassatella Festival on Sunday 15 November 2026, from 10:00 to midnight, in Piazza Europa, Agira.',
  festivalEyebrow: '01 / FLAVOURS AND TRADITIONS',
  festivalTitle: 'The Cassatella Festival.',
  festivalText: 'The festival celebrates Agira’s signature pastry and invites visitors to discover the town through its flavours and traditions.',
  festivalAction: 'Explore the festival page',
  traditionsEyebrow: '02 / FAITH AND TRADITION',
  saintTitle: 'The feast of Saint Philip.',
  saintText: 'On 12 May, Agira celebrates Saint Philip, the town’s patron saint. The next feast will take place on 12 May 2027. The summer celebration is mainly for emigrants returning to Agira.',
  saintAction: 'Discover the feast of Saint Philip',
  nextEyebrow: 'KEEP EXPLORING',
  nextTitle: 'A festival is a good reason to stay a little longer.',
  sights: 'Things to see',
  food: 'Where to eat',
};
const seasonalEvents = lang === 'it' ? [
  {
    id: 'presepe-vivente', image: 'nativityEvent', eyebrow: '03 / LA NOTTE DI NATALE', title: 'Il Presepe Vivente di Agira.',
    date: '2026-12-24', label: 'Giovedì 24 dicembre 2026', day: 'GIOVEDÌ', number: '24', month: 'DICEMBRE', year: '2026',
    paragraphs: [
      'La notte del 24 dicembre il centro storico si anima di figuranti, botteghe e antichi mestieri. Il percorso attraversa la parte alta di Agira e accompagna Maria e Giuseppe fino alla Natività, tra i ruderi del Castello medievale.',
      'Organizzato dall’Associazione Amici del Presepe, l’appuntamento intreccia fede, racconto biblico e tradizioni contadine siciliane. L’edizione del 2026 è la 36ª.',
      'Il percorso apre abitualmente in serata, intorno alle 20:00, e culmina nella rappresentazione della Natività nella notte di Natale. Orari e tappe del programma 2026 saranno aggiornati quando disponibili.',
    ],
    award: 'Il Presepe ha ricevuto il riconoscimento di “Miglior Presepe Vivente d’Italia” per il 2025/2026, nell’ambito del 33° Geraci Eventus Praesepium Meeting.',
  },
  {
    id: 'un-pane-per-la-vita', image: 'breadForLifeEvent', eyebrow: '04 / SAPORI E SOLIDARIETÀ', title: 'Un Pane per la Vita.',
    date: '2027-01-05', label: 'Martedì 5 gennaio 2027', day: 'MARTEDÌ', number: '5', month: 'GENNAIO', year: '2027',
    paragraphs: [
      'Il 5 gennaio 2027 torna nella parte alta del centro storico la 35ª edizione di Un Pane per la Vita: una serata di incontro e solidarietà a favore dell’UNICEF e dei bambini colpiti da guerre e carestie.',
      'Il cuore della manifestazione è il pane casereccio, impastato a mano dalle donne del paese e cotto nei forni tradizionali. Accanto al pane, i sapori della cucina contadina: lenticchie, ceci, fruate e vino casareccio.',
      'L’iniziativa è promossa dall’Associazione Amici del Presepe Agira e dal Comitato Provinciale di Enna per l’UNICEF. L’appuntamento si svolge tradizionalmente dalle 19:00, tra le vie della zona alta del paese.',
    ],
    award: null,
  },
] : [
  {
    id: 'presepe-vivente', image: 'nativityEvent', eyebrow: '03 / CHRISTMAS EVE', title: 'Agira’s Living Nativity.',
    date: '2026-12-24', label: 'Thursday 24 December 2026', day: 'THURSDAY', number: '24', month: 'DECEMBER', year: '2026',
    paragraphs: [
      'On the night of 24 December, Agira’s historic centre comes alive with costumed performers, workshops and traditional crafts. The route winds through the upper town, following Mary and Joseph towards the Nativity among the ruins of the medieval castle.',
      'Organised by the Amici del Presepe association, the event brings together faith, biblical storytelling and Sicily’s rural traditions. The 2026 event marks its 36th edition.',
      'The route usually opens in the evening, around 8 pm, and culminates in the Nativity scene on Christmas night. Times and details for the 2026 programme will be updated when available.',
    ],
    award: 'The event received the “Best Living Nativity in Italy” award for 2025/2026 at the 33rd Geraci Eventus Praesepium Meeting.',
  },
  {
    id: 'un-pane-per-la-vita', image: 'breadForLifeEvent', eyebrow: '04 / FOOD AND SOLIDARITY', title: 'Un Pane per la Vita.',
    date: '2027-01-05', label: 'Tuesday 5 January 2027', day: 'TUESDAY', number: '5', month: 'JANUARY', year: '2027',
    paragraphs: [
      'On 5 January 2027, the upper historic centre hosts the 35th edition of Un Pane per la Vita — Bread for Life: an evening supporting UNICEF and children affected by war and famine.',
      'At its heart is homemade bread, kneaded by local women and baked in traditional ovens. Alongside it are flavours from the local rural kitchen: lentils, chickpeas, fruate and homemade wine.',
      'The event is promoted by the Amici del Presepe Agira association and UNICEF’s provincial committee in Enna. It traditionally begins at 7 pm in the streets of the upper town.',
    ],
    award: null,
  },
];
const festivalHref = pageUrl('festival', lang);
const saintFestivalHref = pageUrl('saintFestival', lang);
const sightsHref = pageUrl('sights', lang);
const foodHref = pageUrl('eat', lang);
---

<Base socialPhoto="town" lang={lang} title={copy.title} description={copy.description} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="events"/>
  <main id="main" tabindex="-1">
    <section class="events-page-hero" aria-labelledby="events-page-title">
      <div class="container">
        <p class="eyebrow events-hero-eyebrow">{copy.eyebrow}</p>
        <div class="events-hero-grid">
          <div class="events-hero-copy">
            <h1 id="events-page-title">{copy.heading}</h1>
            <p>{copy.intro}</p>
            <a class="button button-yellow" href="#events-calendar">{copy.action}<Icon name="arrow"/></a>
          </div>
          <figure class="events-hero-visual">
            <div class="events-hero-photo"><Photo name="town" lang={lang} priority sizes="(max-width: 700px) 92vw, 54vw"/></div>
            <span class="events-hero-year" aria-hidden="true">2026</span>
            <figcaption><span>{lang === 'it' ? 'Agira, tra il paese e il paesaggio' : 'Agira, between town and landscape'}</span><span>{photos.town.credit?.[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="events-calendar" class="events-calendar section" aria-labelledby="events-calendar-title">
      <div class="container">
        <div class="events-calendar-heading">
          <div><p class="eyebrow">{copy.calendarEyebrow}</p><h2 id="events-calendar-title">{copy.calendarTitle}</h2></div>
          <p>{copy.calendarIntro}</p>
        </div>
        <article class="events-featured events-reveal">
          <figure class="events-feature-photo">
            <Photo name="pastry" lang={lang} sizes="(max-width: 700px) 90vw, 50vw"/>
            <figcaption><span>{lang === 'it' ? 'La cassatella di Agira' : 'Cassatella di Agira'}</span><span>{photos.pastry.credit?.[lang]}</span></figcaption>
          </figure>
          <div class="events-feature-copy">
            <p class="eyebrow">{copy.festivalEyebrow}</p>
            <h3>{copy.festivalTitle}</h3>
            <p>{copy.festivalText}</p>
            <a class="text-link" href={festivalHref}>{copy.festivalAction}<Icon name="arrow"/></a>
          </div>
          <aside class="events-date-tile" aria-label={lang === 'it' ? 'Domenica 15 novembre 2026' : 'Sunday 15 November 2026'}>
            <span>{lang === 'it' ? 'DOMENICA' : 'SUNDAY'}</span><strong>15</strong><p>{lang === 'it' ? 'NOVEMBRE' : 'NOVEMBER'}<br/>2026</p><small>AGIRA · SICILIA</small>
          </aside>
        </article>
      </div>
    </section>

    <section class="events-tradition-section" aria-labelledby="events-saint-title">
      <div class="container">
        <article class="events-featured events-reveal">
          <figure class="events-feature-photo">
            <Photo name="abbeyAnelloPanorama" lang={lang} sizes="(max-width: 700px) 90vw, 50vw"/>
            <figcaption><span>{lang === 'it' ? 'La Reale Abbazia di San Filippo ad Agira' : 'The Royal Abbey of San Filippo in Agira'}</span><span>{photos.abbeyAnelloPanorama.credit[lang]}</span></figcaption>
          </figure>
          <div class="events-feature-copy">
            <p class="eyebrow">{copy.traditionsEyebrow}</p>
            <h2 id="events-saint-title">{copy.saintTitle}</h2>
            <p>{copy.saintText}</p>
            <a class="text-link" href={saintFestivalHref}>{copy.saintAction}<Icon name="arrow"/></a>
          </div>
          <aside class="events-date-tile" aria-label={lang === 'it' ? 'Mercoledì 12 maggio 2027' : 'Wednesday 12 May 2027'}>
            <span>{lang === 'it' ? 'MERCOLEDÌ' : 'WEDNESDAY'}</span><strong>12</strong><p>{lang === 'it' ? 'MAGGIO' : 'MAY'}<br/>2027</p><small>AGIRA · SICILIA</small>
          </aside>
        </article>
      </div>
    </section>

    {seasonalEvents.map((event, index) => <section class:list={["events-seasonal-section", "section", { "events-seasonal-section-muted": index % 2 === 1 }]} aria-labelledby={`${event.id}-title`}>
      <div class="container">
        <article class="events-featured events-reveal">
          <figure class="events-feature-photo events-illustration">
            <Photo name={event.image as keyof typeof photos} lang={lang} sizes="(max-width: 700px) 90vw, 45vw"/>
          </figure>
          <div class="events-feature-copy">
            <p class="eyebrow">{event.eyebrow}</p>
            <h2 id={`${event.id}-title`}>{event.title}</h2>
            {event.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            {event.award && <p>{event.award}</p>}
          </div>
          <aside class="events-date-tile" aria-label={event.label}>
            <span>{event.day}</span><strong>{event.number}</strong><p>{event.month}<br/>{event.year}</p><small>AGIRA · SICILIA</small>
          </aside>
        </article>
      </div>
    </section>)}

    <section class="events-seasonal-section section" aria-labelledby="events-motor-title">
      <div class="container">
        <article class="events-featured events-reveal">
          <figure class="events-feature-photo events-motor-poster">
            <Photo name="motorExpo2026Poster" lang={lang} sizes="(max-width: 700px) 90vw, 45vw"/>
            <figcaption>{photos.motorExpo2026Poster.credit[lang]}</figcaption>
          </figure>
          <div class="events-feature-copy">
            <p class="eyebrow">{lang === 'it' ? '05 / MOTORI E PASSIONI' : '05 / MOTORING AND PASSION'}</p>
            <h2 id="events-motor-title">Motor Expo Agira 2027.</h2>
            <p>{lang === 'it' ? 'La 27ª edizione del Motor Expo Agira riunisce appassionati, collezionisti e curiosi al Padiglione Fieristico di Agira. Una mostra-scambio dedicata ad auto, moto, oggettistica e memorabilia d’epoca, organizzata dal Club Motori d’Epoca Agira.' : 'The 27th Motor Expo Agira brings enthusiasts, collectors and curious visitors together at Agira’s Exhibition Pavilion. Organised by the Club Motori d’Epoca Agira, this swap meet celebrates classic cars, motorcycles, vintage objects and memorabilia.'}</p>
            <p>{lang === 'it' ? 'L’appuntamento è previsto a marzo 2027, con ingresso gratuito. Le giornate esatte e il programma saranno pubblicati non appena confermati.' : 'The event is planned for March 2027, with free admission. Exact dates and the programme will be published once confirmed.'}</p>
          </div>
          <aside class="events-date-tile events-date-month" aria-label={lang === 'it' ? 'Marzo 2027, date da confermare' : 'March 2027, dates to be confirmed'}>
            <span>{lang === 'it' ? 'DATE DA CONFERMARE' : 'DATES TO BE CONFIRMED'}</span><strong>2027</strong><p>{lang === 'it' ? 'MARZO' : 'MARCH'}</p><small>AGIRA · SICILIA</small>
          </aside>
        </article>
      </div>
    </section>

    <section class="itinerary-next events-page-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{copy.nextEyebrow}</p><h2>{copy.nextTitle}</h2></div>
        <div class="itinerary-next-links">
          <a class="button button-yellow" href={sightsHref}>{copy.sights}<Icon name="arrow"/></a>
          <a class="text-link" href={foodHref}>{copy.food}<Icon name="diagonal"/></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="events"/>
  <script>import '../scripts/sights-reveal';</script>
</Base>
