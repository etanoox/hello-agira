---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { seminar, seminarCopy } from '../data/aging-seminar';
import { conference, conferenceCopy } from '../data/diodorus-conference';
import photos from '../data/photos.json';
import { pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const it = lang === 'it';
const l = (italian: string, english: string) => it ? italian : english;
const diodorus = conferenceCopy(lang);
const aging = seminarCopy(lang);
const localizedPaths = { it: pageUrl('events', 'it'), en: pageUrl('events', 'en') };
const copy = {
  title: l('Eventi e tradizioni ad Agira | Hello Agira', 'Events and traditions in Agira | Hello Agira'),
  description: l(
    'Il calendario degli eventi ad Agira: feste, sagre, incontri culturali e altre iniziative. Scopri date, luoghi e informazioni sui singoli appuntamenti.',
    'Explore Agira’s events calendar: festivals, local celebrations, cultural talks and more. Find dates, venues and details for each event.',
  ),
  eyebrow: l('AGIRA · IL CALENDARIO DEGLI EVENTI', 'AGIRA · THE EVENTS CALENDAR'),
  heading: l('Ci sono giorni\nche restano.', 'Some days\nstay with you.'),
  intro: l('Feste, incontri e tradizioni raccontano Agira attraverso i suoi sapori, le sue storie e il piacere di ritrovarsi.', 'Festivals, talks and traditions tell the story of Agira through its flavours, its history and the joy of coming together.'),
  action: l('Scopri gli appuntamenti', 'Explore the calendar'),
  calendarEyebrow: l('IN CALENDARIO', 'ON THE CALENDAR'),
  calendarTitle: l('Gli appuntamenti ad Agira.', 'What’s on in Agira.'),
  calendarIntro: l(
    'Dalle feste patronali alle sagre, dagli incontri culturali alle iniziative della comunità: trova gli appuntamenti in ordine di data e apri le schede per scoprire luoghi e programmi.',
    'From patron saint celebrations and food festivals to cultural talks and community events, browse the calendar by date and open each event for venue and programme details.',
  ),
  nextEyebrow: l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING'),
  nextTitle: l('Un appuntamento è anche un buon motivo per fermarsi.', 'An event is a good reason to stay a little longer.'),
  sights: l('Cosa vedere', 'Things to see'),
  food: l('Dove mangiare', 'Where to eat'),
};

interface CalendarEvent {
  id: string;
  date: string;
  schedule?: { start: string; label: string; venue: string; admission: string };
  image: keyof typeof photos;
  poster?: boolean;
  caption?: string;
  credit: string;
  creditUrl?: string;
  category: string;
  title: string;
  paragraphs?: string[];
  href: string;
  action: string;
  badge: { label: string; top: string; number: string; month: string; year?: string; kind?: 'range' | 'month' };
}

const events: CalendarEvent[] = [
  {
    id: 'events-cassatella', date: '2026-11-13', image: 'pastry',
    caption: l('La cassatella di Agira', 'Cassatella di Agira'), credit: photos.pastry.credit[lang],
    category: l('Sapori e tradizioni', 'Flavours and traditions'),
    title: l('La Sagra della Cassatella.', 'The Cassatella Festival.'),
    paragraphs: [l(
      'La 14ª edizione della Sagra della Cassatella e le vie dei sapori, dal 13 al 15 novembre 2026, ha celebrato il dolce simbolo di Agira con stand, musica dal vivo, folklore, street food e attività per bambini. La sagra si è svolta in Piazza Europa, con ingresso gratuito.',
      'The 14th Cassatella Festival, held from 13 to 15 November 2026, celebrated Agira’s signature pastry with stands, live music, folklore, street food and children’s activities. Admission to the festival in Piazza Europa was free.',
    )],
    href: pageUrl('festival', lang), action: l('Vai alla pagina della Sagra', 'Explore the festival page'),
    badge: { label: l('Dal 13 al 15 novembre 2026', '13–15 November 2026'), top: l('14ª EDIZIONE', '14TH EDITION'), number: '13–15', month: l('NOVEMBRE', 'NOVEMBER'), year: '2026', kind: 'range' },
  },
  {
    id: 'events-conference', date: conference.start.slice(0, 10), schedule: { start: conference.start, label: diodorus.date, venue: diodorus.venue, admission: diodorus.admission },
    image: conference.image, poster: true, credit: diodorus.credit,
    category: diodorus.category, title: diodorus.name,
    href: pageUrl('diodorusConference', lang), action: l('Scopri il convegno', 'Explore the conference'),
    badge: { label: diodorus.date, top: l('SABATO', 'SATURDAY'), number: '21', month: l('NOVEMBRE', 'NOVEMBER'), year: '2026' },
  },
  {
    id: 'events-aging', date: seminar.start.slice(0, 10), schedule: { start: seminar.start, label: aging.date, venue: aging.venue, admission: aging.admission },
    image: seminar.image, poster: true, credit: aging.credit,
    category: aging.category, title: aging.name,
    href: pageUrl('agingSeminar', lang), action: l('Scopri il seminario', 'Explore the seminar'),
    badge: { label: aging.date, top: l('SABATO', 'SATURDAY'), number: '28', month: l('NOVEMBRE', 'NOVEMBER'), year: '2026' },
  },
  {
    id: 'presepe-vivente', date: '2026-12-24', image: 'nativity2026HelloPoster', poster: true,
    caption: l('Presepe Vivente di Agira · 2026', 'Agira Living Nativity · 2026'), credit: photos.nativity2026HelloPoster.credit[lang],
    category: l('La notte di Natale', 'Christmas Eve'),
    title: l('Il Presepe Vivente di Agira.', 'Agira’s Living Nativity.'),
    paragraphs: [
      l('La notte del 24 dicembre il centro storico si anima di figuranti, botteghe e antichi mestieri. Il percorso attraversa la parte alta di Agira e accompagna Maria e Giuseppe fino alla Natività, tra i ruderi del Castello medievale.', 'On the night of 24 December, Agira’s historic centre comes alive with costumed performers, workshops and traditional crafts. The route winds through the upper town, following Mary and Joseph towards the Nativity among the ruins of the medieval castle.'),
      l('Il Presepe ha ricevuto il riconoscimento di “Miglior Presepe Vivente d’Italia” per il 2025/2026, nell’ambito del 33° Geraci Eventus Praesepium Meeting.', 'The event received the “Best Living Nativity in Italy” award for 2025/2026 at the 33rd Geraci Eventus Praesepium Meeting.'),
    ],
    href: pageUrl('nativity', lang), action: l('Scopri il Presepe Vivente', 'Explore the Living Nativity'),
    badge: { label: l('Giovedì 24 dicembre 2026', 'Thursday 24 December 2026'), top: l('GIOVEDÌ', 'THURSDAY'), number: '24', month: l('DICEMBRE', 'DECEMBER'), year: '2026' },
  },
  {
    id: 'natale-nessun-dorma', date: '2026-12-25', image: 'nessunDormaChristmas',
    caption: l('Una serata al Nessun Dorma', 'An evening at Nessun Dorma'), credit: photos.nessunDormaChristmas.credit[lang],
    category: l('La notte continua', 'The night continues'),
    title: l('Natale al Nessun Dorma.', 'Christmas at Nessun Dorma.'),
    paragraphs: [l('Dalle 00:01 alle 05:00 del 25 dicembre 2026, l’appuntamento annuale al Pub Nessun Dorma, in Via Cairoli 21. Ingresso gratuito per continuare la notte di Natale ad Agira, anche dopo la visita al Presepe Vivente.', 'From 00:01 to 05:00 on 25 December 2026, the annual gathering at Pub Nessun Dorma, Via Cairoli 21. Free admission to continue Christmas night in Agira, including after a visit to the Living Nativity.')],
    href: pageUrl('nessunDormaChristmas', lang), action: l('Scopri Natale al Nessun Dorma', 'Explore Christmas at Nessun Dorma'),
    badge: { label: l('Venerdì 25 dicembre 2026', 'Friday 25 December 2026'), top: l('VENERDÌ', 'FRIDAY'), number: '25', month: l('DICEMBRE', 'DECEMBER'), year: '2026' },
  },
  {
    id: 'un-pane-per-la-vita', date: '2027-01-05', image: 'bread2027HelloPoster', poster: true,
    caption: 'Un Pane per la Vita · 2027', credit: photos.bread2027HelloPoster.credit[lang],
    category: l('Sapori e solidarietà', 'Food and solidarity'), title: 'Un Pane per la Vita.',
    paragraphs: [l('Il 5 gennaio 2027 torna nella parte alta del centro storico la 35ª edizione di Un Pane per la Vita: una serata di incontro e solidarietà a favore dell’UNICEF e dei bambini colpiti da guerre e carestie.', 'On 5 January 2027, the upper historic centre hosts the 35th edition of Un Pane per la Vita — Bread for Life: an evening supporting UNICEF and children affected by war and famine.')],
    href: pageUrl('breadForLife', lang), action: l('Scopri Un Pane per la Vita', 'Explore Un Pane per la Vita'),
    badge: { label: l('Martedì 5 gennaio 2027', 'Tuesday 5 January 2027'), top: l('MARTEDÌ', 'TUESDAY'), number: '5', month: l('GENNAIO', 'JANUARY'), year: '2027' },
  },
  {
    id: 'events-motor', date: '2027-03', image: 'motorExpoHall',
    caption: l('Motor Expo Agira · Edizione precedente', 'Motor Expo Agira · Previous edition'),
    credit: photos.motorExpoHall.credit[lang], creditUrl: 'https://www.facebook.com/agiraclub',
    category: l('Motori e passioni', 'Motoring and passion'), title: 'Motor Expo Agira 2027.',
    paragraphs: [
      l('La 27ª edizione del Motor Expo Agira riunisce appassionati, collezionisti e curiosi al Padiglione Fieristico di Agira. Una mostra-scambio dedicata ad auto, moto, oggettistica e memorabilia d’epoca, organizzata dal Club Motori d’Epoca Agira.', 'The 27th Motor Expo Agira brings enthusiasts, collectors and curious visitors together at Agira’s Exhibition Pavilion. Organised by the Club Motori d’Epoca Agira, this swap meet celebrates classic cars, motorcycles, vintage objects and memorabilia.'),
      l('L’appuntamento è previsto a marzo 2027, con ingresso gratuito. Le giornate esatte e il programma saranno pubblicati non appena confermati.', 'The event is planned for March 2027, with free admission. Exact dates and the programme will be published once confirmed.'),
    ],
    href: pageUrl('motorExpo', lang), action: l('Scopri il Motor Expo Agira', 'Explore Motor Expo Agira'),
    badge: { label: l('Marzo 2027, date da confermare', 'March 2027, dates to be confirmed'), top: l('DATE DA CONFERMARE', 'DATES TO BE CONFIRMED'), number: '2027', month: l('MARZO', 'MARCH'), kind: 'month' },
  },
  {
    id: 'events-saint', date: '2027-05-12', image: 'abbeyAnelloPanorama',
    caption: l('La Reale Abbazia di San Filippo ad Agira', 'The Royal Abbey of San Filippo in Agira'), credit: photos.abbeyAnelloPanorama.credit[lang],
    category: l('Fede e tradizione', 'Faith and tradition'), title: l('La festa di San Filippo.', 'The feast of Saint Philip.'),
    paragraphs: [l('Il 12 maggio Agira celebra San Filippo, patrono del paese. La prossima festa sarà il 12 maggio 2027. La ricorrenza estiva è dedicata soprattutto agli emigrati che tornano ad Agira.', 'On 12 May, Agira celebrates Saint Philip, the town’s patron saint. The next feast will take place on 12 May 2027. The summer celebration is mainly for emigrants returning to Agira.')],
    href: pageUrl('saintFestival', lang), action: l('Scopri la festa di San Filippo', 'Discover the feast of Saint Philip'),
    badge: { label: l('Mercoledì 12 maggio 2027', 'Wednesday 12 May 2027'), top: l('MERCOLEDÌ', 'WEDNESDAY'), number: '12', month: l('MAGGIO', 'MAY'), year: '2027' },
  },
];
events.sort((a, b) => a.date.localeCompare(b.date));

const sightsHref = pageUrl('sights', lang);
const foodHref = pageUrl('eat', lang);
---

<Base socialPhoto="town" lang={lang} title={copy.title} description={copy.description} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="events"/>
  <main id="main" tabindex="-1">
    <section class="events-page-hero" aria-labelledby="events-page-title">
      <div class="container">
        <p class="eyebrow events-hero-eyebrow">{copy.eyebrow}</p>
        <div class="events-hero-grid">
          <div class="events-hero-copy">
            <h1 id="events-page-title">{copy.heading}</h1>
            <p>{copy.intro}</p>
            <a class="button button-yellow" href="#events-calendar">{copy.action}<Icon name="arrow"/></a>
          </div>
          <figure class="events-hero-visual">
            <div class="events-hero-photo"><Photo name="town" lang={lang} priority sizes="(max-width: 700px) 92vw, 54vw"/></div>
            <figcaption><span>{lang === 'it' ? 'Agira, tra il paese e il paesaggio' : 'Agira, between town and landscape'}</span><span>{photos.town.credit?.[lang]}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="events-calendar" class="events-calendar section" aria-labelledby="events-calendar-title">
      <div class="container">
        <div class="events-calendar-heading">
          <div><p class="eyebrow">{copy.calendarEyebrow}</p><h2 id="events-calendar-title">{copy.calendarTitle}</h2></div>
          <p>{copy.calendarIntro}</p>
        </div>
      </div>
      <div class="events-list">
        {events.map(event => <div class="events-row">
          <article class="container events-featured events-reveal" aria-labelledby={`${event.id}-title`}>
            <figure class:list={["events-feature-photo", { "events-editorial-poster": event.poster }]}>
              <Photo name={event.image} lang={lang} sizes="(max-width: 700px) 90vw, 45vw"/>
              <figcaption>
                {event.caption && <span>{event.caption}</span>}
                {event.creditUrl ? <a href={event.creditUrl} target="_blank" rel="noopener noreferrer">{event.credit}</a> : <span>{event.credit}</span>}
              </figcaption>
            </figure>
            <div class="events-feature-copy">
              <p class="eyebrow">{event.category}</p>
              <h3 id={`${event.id}-title`}>{event.title}</h3>
              {event.schedule && <p><time datetime={event.schedule.start}>{event.schedule.label}</time><br/>{event.schedule.venue}<br/>{event.schedule.admission}</p>}
              {event.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
              <a class="text-link" href={event.href}>{event.action}<Icon name="arrow"/></a>
            </div>
            <aside class:list={["events-date-tile", { "events-date-range": event.badge.kind === 'range', "events-date-month": event.badge.kind === 'month' }]} aria-label={event.badge.label}>
              <span>{event.badge.top}</span><strong>{event.badge.number}</strong>
              <p><time datetime={event.date}>{event.badge.month}{event.badge.year && <><br/>{event.badge.year}</>}</time></p>
              <small>AGIRA · SICILIA</small>
            </aside>
          </article>
        </div>)}
      </div>
    </section>

    <section class="itinerary-next events-page-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{copy.nextEyebrow}</p><h2>{copy.nextTitle}</h2></div>
        <div class="itinerary-next-links">
          <a class="button button-yellow" href={sightsHref}>{copy.sights}<Icon name="arrow"/></a>
          <a class="text-link" href={foodHref}>{copy.food}<Icon name="diagonal"/></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="events"/>
  <script>import '../scripts/sights-reveal';</script>
</Base>

<style>
  .events-editorial-poster :global(img){display:block;width:100%;height:auto;aspect-ratio:auto;object-fit:contain}
  .events-calendar{padding-bottom:0}
  .events-row{padding-block:clamp(2.25rem,5vw,4rem);background:var(--white)}
  .events-list > .events-row:nth-child(even){background:#e8eadf}
  .events-row .events-featured{padding-top:0;border-top:0}
  .events-date-range>strong{font-size:clamp(2.75rem,3.5vw,3.75rem);letter-spacing:-.07em;white-space:nowrap}
  @media(max-width:700px){
    .events-date-range{grid-template-columns:auto minmax(0,1fr)}
    .events-date-range>p{grid-column:2;grid-row:2}
    .events-date-range>small{grid-column:2;grid-row:3}
  }
</style>
