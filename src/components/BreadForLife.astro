---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import { getBreadForLife, getBreadForLifeGraph } from '../data/bread-for-life';
import { pageUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getBreadForLife(lang);
const paths = { it: pageUrl('breadForLife', 'it'), en: pageUrl('breadForLife', 'en') };
const hero = 'breadForLifeGallery03';
const imageUrl = `/images/${hero}-${Math.max(...photos[hero].widths)}.webp`;
const items = Array.from({length: 8}, (_, i) => ({key: `breadForLifeGallery${String(i+1).padStart(2,'0')}` as keyof typeof photos, title: l('Un Pane per la Vita · Foto dell’associazione', 'Un Pane per la Vita · Association photograph')}));
const graph = Astro.site?.protocol === 'https:' ? getBreadForLifeGraph(Astro.site, lang) : undefined;
---
<Base socialPhoto={hero} lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="events" alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="bread-title"><div class="container">
      <p class="eyebrow festival-topline">{l('AGIRA · TRADIZIONE E SOLIDARIETÀ', 'AGIRA · TRADITION AND SOLIDARITY')}</p>
      <div class="festival-hero-grid"><div class="route-page-copy"><h1 id="bread-title">{c.heading}</h1><p>{c.intro}</p>
        <div class="festival-date-lockup"><span>{l('35ª EDIZIONE · INGRESSO GRATUITO', '35TH EDITION · FREE ADMISSION')}</span><div><strong>05</strong><p>{l('GENNAIO', 'JANUARY')}<br/>2027</p></div></div>
        <a class="button button-yellow" href="#programma">{l('L’appuntamento', 'The event')}<Icon name="arrow"/></a>
      </div><figure class="route-page-photo festival-hero-photo"><a class="photo-link" href={imageUrl} data-gallery-open={hero} aria-haspopup="dialog" aria-label={l('Ingrandisci la foto della manifestazione', 'Enlarge the event photograph')}><Photo name={hero} lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></a><figcaption><span>{l('Tradizione e solidarietà ad Agira', 'Tradition and solidarity in Agira')}</span><span>{photos[hero].credit[lang]}</span></figcaption></figure></div>
    </div></section>
    {c.sections.map(section => <section id={section.id} class="festival-story section" aria-labelledby={`${section.id}-title`}><div class="container festival-story-grid"><div><p class="eyebrow">{section.label}</p><h2 id={`${section.id}-title`}>{section.title}</h2></div><div class="festival-story-copy">{section.paragraphs.map(text => <p>{text}</p>)}{section.id === 'comunita' && <div class="festival-plan-links"><a class="text-link" href={pageUrl('nativity', lang)}>{l('Scopri il Presepe Vivente', 'Explore the Living Nativity')}<Icon name="arrow"/></a></div>}</div></div></section>)}
    <section id="fotografie" class="section nativity-muted" aria-labelledby="bread-photos-title"><div class="container">
      <div class="section-heading"><div><p class="eyebrow">{l('04 / IL RACCONTO FOTOGRAFICO', '04 / THE PHOTOGRAPHIC STORY')}</p><h2 id="bread-photos-title">{l('I volti della comunità.', 'The faces of the community.')}</h2></div><p>{l('Preparativi e momenti della manifestazione nelle fotografie dell’Associazione Amici del Presepe.', 'Preparations and moments from the event in photographs from the Associazione Amici del Presepe.')}</p></div>
      <div class="nativity-photo-grid">{items.map((item, index) => <figure><a class="photo-link" href={`/images/${item.key}-${Math.max(...photos[item.key].widths)}.webp`} data-gallery-open={item.key} aria-haspopup="dialog" aria-label={`${l('Ingrandisci la fotografia', 'Enlarge photograph')} ${index+1}`}><Photo name={item.key} lang={lang} sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 29vw"/><span class="photo-view"><Icon name="plus"/></span></a><figcaption><span>{String(index+1).padStart(2,'0')} / Un Pane per la Vita</span><span>{photos[item.key].credit[lang]}</span></figcaption></figure>)}</div>
    </div></section>
    <section class="stay-practical-section section" aria-labelledby="bread-faq-title"><div class="container stay-practical-grid"><div class="stay-practical-intro"><p class="eyebrow">{l('05 / PRIMA DI PARTIRE', '05 / BEFORE YOU SET OFF')}</p><h2 id="bread-faq-title">{l('Preparare la serata.', 'Plan your evening.')}</h2></div><div class="stay-practical-list">{c.faqs.map((faq, i) => <details><summary><span class="small-number">0{i + 1}</span><h3>{faq.q}</h3><Icon name="plus"/></summary><div class="stay-practical-answer"><p>{faq.a}</p></div></details>)}</div></div></section>
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Una comunità che accoglie.\nUn paese da scoprire.', 'A welcoming community.\nA town to discover.')}</h2></div><div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('events', lang)}>{l('Tutti gli eventi', 'All events')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('stay', lang)}>{l('Dove dormire', 'Where to stay')}<Icon name="diagonal"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} currentPage="events" alternatePaths={paths}/>
  <PhotoGallery lang={lang} items={items}/>
  {graph && <script type="application/ld+json" set:html={serializeSchema(graph)}/>}
</Base>
