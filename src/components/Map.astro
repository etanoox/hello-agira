---
import { places } from '../data/places';
import { getCopy } from '../data/copy';
import { sectionIds, type Locale } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props { lang: Locale; }
const {lang} = Astro.props;
const c=getCopy(lang);
---
<section class="section map-section" id={sectionIds.map[lang]} aria-labelledby="map-title">
  <div class="container">
    <p class="eyebrow">{c.mapLabel}</p>
    <div class="section-heading"><h2 id="map-title">{c.mapTitle}</h2><p>{c.mapIntro}</p></div>
    <div class="map-layout" data-map-root data-map-filter="sights" data-lang={lang} data-approximate={c.mapApproximate} data-loading={c.mapLoading} data-ready={c.mapReady} data-error={c.mapError}>
      <div class="map-info">
        <div class="map-location"><Icon name="pin" /><span>AGIRA<br/><small>SICILIA, ITALIA</small></span></div>
        <div class="map-filters" role="group" aria-label={c.mapCategories}>
          <button type="button" data-map-filter-button="sights" aria-pressed="true">{c.mapSights}</button>
          <button type="button" data-map-filter-button="accommodation" aria-pressed="false">{c.mapAccommodation}</button>
          <button type="button" data-map-filter-button="all" aria-pressed="false">{c.mapAll}</button>
        </div>
        <ul class="map-places">{places.map((place,index) => <li data-map-place-row data-kind={place.kind === 'accommodation' ? 'accommodation' : 'sights'} hidden={place.kind === 'accommodation'}><span class="place-number">{String(index+1).padStart(2,'0')}</span><a href={`https://www.openstreetmap.org/?mlat=${place.coordinates[1]}&mlon=${place.coordinates[0]}#map=17/${place.coordinates[1]}/${place.coordinates[0]}`} data-place={place.id}>{place.name[lang]}<Icon name="diagonal"/></a></li>)}</ul>
        <a class="text-link" href="https://www.openstreetmap.org/#map=14/37.6560/14.5200">{c.mapExternal}<Icon name="diagonal"/></a>
      </div>
      <div class="map-frame">
        <div class="map-cover" data-map-cover>
          <span class="map-word" aria-hidden="true">Agira.</span>
          <span class="map-coordinate">37°39′ N &nbsp; 14°31′ E</span>
          <button class="button button-yellow" data-map-load><Icon name="pin"/>{c.mapActivate}</button>
          <p>{c.mapPrivacy}</p>
        </div>
        <div class="map-canvas" data-map-canvas aria-label={c.mapTitle} hidden></div>
        <p class="map-status" data-map-status role="status" aria-live="polite"></p>
        <noscript><p class="map-nojs">{c.mapExternal}: <a href="https://www.openstreetmap.org/#map=14/37.6560/14.5200">OpenStreetMap</a></p></noscript>
      </div>
    </div>
  </div>
</section>
<script>import '../scripts/map-loader';</script>
