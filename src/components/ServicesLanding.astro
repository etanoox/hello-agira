---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './Icon.astro';
import { serviceGroups, serviceMapUrl } from '../data/services';
import { pageUrl, type Locale } from '../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const paths = { it: pageUrl('services', 'it'), en: pageUrl('services', 'en') };
const title = l('Servizi utili ad Agira', 'Useful services in Agira');
const description = l('Farmacie, tabaccherie, ufficio postale e ATM/Bancomat ad Agira: indirizzi, numeri di telefono e collegamenti a Google Maps per trovare il locale.', 'Pharmacies, tobacconists, the post office and cash machines in Agira: addresses, phone numbers and Google Maps links to find each location.');
---
<Base lang={lang} title={`${title} | Hello Agira`} description={description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="services"/>
  <main id="main" tabindex="-1">
    <section class="services-hero">
      <div class="container">
        <p class="eyebrow">{l('AGIRA · INFORMAZIONI PRATICHE', 'AGIRA · PRACTICAL INFORMATION')}</p>
        <h1>{l('Servizi utili.', 'Useful services.')}</h1>
        <p class="services-intro">{l('I riferimenti da tenere a portata di mano, per chi visita Agira e per chi la vive ogni giorno.', 'The essentials to keep handy, whether you are visiting Agira or call it home.')}</p>
        <nav class="services-index" aria-label={l('Categorie dei servizi', 'Service categories')}>
          {serviceGroups.map(group => <a href={`#${group.id}`}>{group.title[lang]}<span>{String(group.places.length).padStart(2, '0')}</span><Icon name="arrow"/></a>)}
        </nav>
      </div>
    </section>
    <div class="container services-body">
      {serviceGroups.map((group, index) => <section class="service-section" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="service-heading"><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {l('IN PAESE', 'IN TOWN')}</p><h2 id={`${group.id}-title`}>{group.title[lang]}</h2></div>
        <div class="service-grid">
          {group.places.map(place => <article class="service-card">
            <p class="service-category">{group.title[lang]}</p>
            <h3>{place.name}</h3>
            <p class="service-address">{place.address && <>{place.address}<br/></>}Agira</p>
            {place.phone && <p class="service-phone"><span>{l('Telefono', 'Phone')}</span> {lang === 'en' ? '+39 ' : ''}{place.phone}</p>}
            <a class="text-link" href={serviceMapUrl(place)} target="_blank" rel="noopener noreferrer" aria-label={`${l('Trova il locale', 'Find the location')}: ${place.name} (Google Maps)`}>{l('Trova il locale', 'Find the location')}<Icon name="diagonal"/></a>
          </article>)}
        </div>
      </section>)}
    </div>
  </main>
  <SiteFooter lang={lang} currentPage="services"/>
</Base>
<style>
  .services-hero{background:var(--forest);color:var(--white);padding:10rem 0 3rem}
  .services-hero .eyebrow{color:var(--grain)}
  h1{font-size:clamp(3.5rem,8vw,7.5rem);line-height:1;letter-spacing:-.055em;max-width:100%}
  .services-intro{max-width:620px;font-size:1.2rem;line-height:1.6;margin:1.8rem 0 3rem;color:var(--white)}
  .services-index{display:flex;flex-wrap:wrap;gap:.75rem}
  .services-index a{display:flex;align-items:center;gap:1rem;border:1px solid #ffffff55;border-radius:3px;padding:.8rem 1.1rem;min-height:48px}
  .services-index a:hover{background:var(--grain);color:var(--forest);border-color:var(--grain)}
  .services-index span{font-size:.75rem;opacity:.8}.services-index :global(svg){width:18px;height:18px}
  .services-body{padding-block:1rem 5rem}.service-section{padding-top:3.5rem;scroll-margin-top:2rem}
  .service-heading{margin-bottom:1.8rem}.service-heading .eyebrow{margin-bottom:.7rem}.service-heading h2{font-size:clamp(2.2rem,4vw,3.5rem)}
  .service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}
  .service-card{display:flex;flex-direction:column;border:1px solid var(--line);padding:1.8rem;background:var(--white);min-width:0}
  .service-category{text-transform:uppercase;letter-spacing:.1em;font-size:.7rem;color:var(--muted);margin-bottom:1rem}
  .service-card h3{font-size:1.65rem;line-height:1.15;letter-spacing:-.025em;margin-bottom:1.3rem;overflow-wrap:anywhere}
  .service-address{line-height:1.6;margin-bottom:.8rem}.service-phone{font-size:.9rem;margin-bottom:1.8rem}.service-phone span{color:var(--muted);display:block;font-size:.75rem;margin-bottom:.25rem}
  .service-card .text-link{margin-top:auto;align-self:flex-start;min-height:44px}
  @media(max-width:1000px){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.services-hero{padding:8rem 0 2rem}.services-intro{font-size:1.05rem;margin-bottom:2rem}.services-index{flex-direction:column}.services-index a :global(svg){margin-left:auto}.service-grid{grid-template-columns:1fr}.service-card{padding:1.5rem}.service-section{padding-top:2.8rem}.services-body{padding-bottom:3rem}}
</style>
