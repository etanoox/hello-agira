---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import PhotoGallery from './PhotoGallery.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import photos from '../data/photos.json';
import { getHistoryPage } from '../data/history';
import { pageUrl, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const page = getHistoryPage(lang);
const localizedPaths = { it: pageUrl('history', 'it'), en: pageUrl('history', 'en') };
const heroPhoto = photos.hero;
---

<Base lang={lang} title={page.title} description={page.description} canonicalPath={localizedPaths[lang]} alternatePaths={localizedPaths}>
  <SiteHeader lang={lang} currentPage="history"/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero history-page-hero" aria-labelledby="history-page-title">
      <div class="container route-page-hero-grid">
        <div class="route-page-copy">
          <p class="eyebrow">{page.eyebrow}</p>
          <h1 id="history-page-title">{page.heading}</h1>
          <p>{page.intro}</p>
          <a class="button button-yellow" href="#history-chapters">{page.action}<Icon name="arrow"/></a>
        </div>
        <figure class="route-page-photo history-page-photo">
          <a class="photo-link" href={`/images/hero-${Math.max(...heroPhoto.widths)}.webp`} data-gallery-open="hero" aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${heroPhoto.alt[lang]}`}>
            <Photo name="hero" lang={lang} priority sizes="(max-width: 700px) 90vw, 48vw"/>
            <span class="photo-view"><Icon name="plus"/></span>
          </a>
          <figcaption>
            <span>{lang === 'it' ? 'Agira, tra il paese e il paesaggio' : 'Agira, between town and countryside'}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="history-reading section" aria-labelledby="history-reading-title">
      <div class="container history-reading-grid">
        <p class="eyebrow">{page.sectionEyebrow}</p>
        <div><h2 id="history-reading-title">{page.sectionTitle}</h2><p>{page.readingText}</p></div>
      </div>
    </section>

    <section id="history-chapters" class="history-chapters section" aria-label={lang === 'it' ? 'Quattro tracce della storia di Agira' : 'Four traces of Agira’s history'}>
      <div class="container">
        {page.chapters.map((chapter) => {
          const imageKey = chapter.image as keyof typeof photos | null;
          const photo = imageKey ? photos[imageKey] : null;
          const largestWidth = photo ? Math.max(...photo.widths) : 0;
          return <article class={`history-chapter history-chapter-${chapter.number}${photo ? ' has-image' : ' is-typographic'}`} id={`history-${chapter.id}`}>
            <div class="history-chapter-copy">
              <div class="history-chapter-top"><span>{chapter.number}</span><p class="eyebrow">{chapter.eyebrow}</p></div>
              <h2>{chapter.title}</h2>
              <p>{chapter.text}</p>
              <div class="history-source-links">{chapter.sourceLinks.map(source => <a class="text-link" href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<Icon name="diagonal"/></a>)}</div>
            </div>
            {photo && imageKey && <figure class="history-chapter-visual">
              <a class="photo-link" href={`/images/${imageKey}-${largestWidth}.webp`} data-gallery-open={imageKey} aria-haspopup="dialog" aria-label={`${lang === 'it' ? 'Apri la fotografia' : 'Open photograph'}: ${photo.alt[lang]}`}>
                <Photo name={imageKey} lang={lang} sizes="(max-width: 700px) 90vw, 48vw"/>
                <span class="photo-view"><Icon name="plus"/></span>
              </a>
              <figcaption><span>{photo.alt[lang]}</span><a href={photo.source} target="_blank" rel="noopener noreferrer">© {photo.author} · {photo.license}<Icon name="diagonal"/></a></figcaption>
            </figure>}
            {!photo && <div class="history-type-art" aria-hidden="true"><span>Agyrion</span><small>Bibliotheca historica</small></div>}
          </article>;
        })}
      </div>
    </section>

    <section class="history-timeline" aria-labelledby="history-timeline-title">
      <div class="container">
        <div class="history-timeline-heading"><p class="eyebrow">{page.timelineEyebrow}</p><h2 id="history-timeline-title">{page.timelineTitle}</h2></div>
        <ol class="history-timeline-list">
          {page.timeline.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer"><span class="history-timeline-date">{item.date}</span><span>{item.text}</span><Icon name="diagonal"/></a></li>)}
        </ol>
      </div>
    </section>

    <aside class="history-tradition-note"><div class="container"><div><p class="eyebrow">{lang === 'it' ? 'UNA NOTA SULLE FONTI' : 'A NOTE ON THE SOURCES'}</p><h2>{page.traditionTitle}</h2></div><div><p>{page.traditionText}</p><a class="text-link" href={page.sources.saint} target="_blank" rel="noopener noreferrer">{page.traditionSource}<Icon name="diagonal"/></a></div></div></aside>

    <section class="itinerary-next history-page-next" aria-label={lang === 'it' ? 'Continua a esplorare' : 'Keep exploring'}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{page.nextEyebrow}</p><h2>{page.nextTitle}</h2></div>
        <div class="itinerary-next-links">
          <a class="button button-yellow" href={page.sightsHref}>{page.sightsLink}<Icon name="arrow"/></a>
          <a class="text-link" href={page.routesHref}>{page.routesLink}<Icon name="diagonal"/></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="history"/>
  <PhotoGallery lang={lang}/>
  <script>import '../scripts/sights-reveal';</script>
</Base>
