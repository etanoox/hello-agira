---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoStoryGallery from './PhotoStoryGallery.astro';
import galleryData from '../data/beautiful-villages-gallery.json';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import { getBeautifulVillages } from '../data/beautiful-villages';
import { pageUrl, sightUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getBeautifulVillages(lang);
const paths = { it: pageUrl('beautifulVillages', 'it'), en: pageUrl('beautifulVillages', 'en') };
const hero = 'borghiAnello33' as const;
const heroUrl = `/images/${hero}-${Math.max(...photos[hero].widths.filter(width => width <= 1800))}.webp`;
const items = galleryData.map(item => ({ key: item.key as keyof typeof photos, title: item.title[lang] }));
const timelineLinks = ['#associazione', '#riconoscimento', '#festa-della-bandiera'];
const chapterLinks: Record<string, { href: string; label: string }[]> = {
  'festa-della-bandiera': [{ href: sightUrl('zuccaro', lang), label: l('Scopri Palazzo Zuccaro', 'Explore Palazzo Zuccaro') }],
  'centro-storico': [{ href: sightUrl('rocche', lang), label: l('Il Quartiere delle Rocche', 'The Rocche Quarter') }],
  'chiese-arte-memorie': [
    { href: sightUrl('santaMariaMaggiore', lang), label: l('Santa Maria Maggiore', 'Santa Maria Maggiore') },
    { href: sightUrl('santaMargherita', lang), label: l('Santa Margherita', 'Santa Margherita') },
    { href: sightUrl('abbey', lang), label: l('Abbazia di San Filippo', 'San Filippo Abbey') },
    { href: sightUrl('aron', lang), label: l('L’Aron in pietra', 'The stone Aron') },
  ],
  'castello-paesaggio': [{ href: sightUrl('castle', lang), label: l('Scopri il Castello', 'Explore the castle') }],
  'cassatella-sapori': [{ href: pageUrl('cassatella', lang), label: l('La cassatella di Agira', 'Cassatella di Agira') }],
  'organizza-la-visita': [
    { href: pageUrl('routes', lang), label: l('Scegli un itinerario', 'Choose an itinerary') },
    { href: pageUrl('eat', lang), label: l('Dove mangiare', 'Where to eat') },
    { href: pageUrl('stay', lang), label: l('Dove dormire', 'Where to stay') },
  ],
};
// Informational page: historical milestones are not upcoming Event entities.
const structured = Astro.site?.protocol === 'https:' ? {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'BreadcrumbList', '@id': new URL(paths[lang] + '#breadcrumb', Astro.site).href, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hello Agira', item: new URL(`/${lang}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: l('Agira tra i Borghi più belli d’Italia', 'Agira among Italy’s Most Beautiful Villages'), item: new URL(paths[lang], Astro.site).href },
    ] },
    { '@type': 'WebPage', '@id': new URL(paths[lang] + '#page', Astro.site).href,
      breadcrumb: { '@id': new URL(paths[lang] + '#breadcrumb', Astro.site).href },
      primaryImageOfPage: { '@type': 'ImageObject', contentUrl: new URL(heroUrl, Astro.site).href, caption: photos[hero].alt[lang], creditText: photos[hero].credit[lang], creator: { '@type': 'Person', name: photos[hero].author } },
    },
  ],
} : undefined;
---
<Base socialPhoto={hero} lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="borghi-title"><div class="container">
      <p class="eyebrow festival-topline">{l('AGIRA · PATRIMONIO E IDENTITÀ', 'AGIRA · HERITAGE AND IDENTITY')}</p>
      <div class="festival-hero-grid"><div class="route-page-copy"><h1 id="borghi-title">{c.heading}</h1><p>{c.introduction}</p>
        <div class="festival-date-lockup"><span>{l('NELLA RETE NAZIONALE DAL', 'PART OF THE NATIONAL NETWORK SINCE')}</span><div><strong>2023</strong><p>{l('STORIA, ARTE', 'HISTORY, ART')}<br/>{l('E PAESAGGIO', 'AND LANDSCAPE')}</p></div></div>
        <a class="button button-yellow" href="#timeline">{l('Le tappe del riconoscimento', 'The milestones')}<Icon name="arrow"/></a>
      </div><figure class="route-page-photo festival-hero-photo"><a class="photo-link" href={heroUrl} data-gallery-open={hero} aria-haspopup="dialog" aria-label={l('Ingrandisci la foto della festa della bandiera', 'Enlarge the flag celebration photograph')}><Photo name={hero} lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></a><figcaption><span>{items[0].title}</span><span>{photos[hero].credit[lang]}</span></figcaption></figure></div>
    </div></section>
    <section class="festival-story section" aria-label={l('Un invito alla scoperta', 'An invitation to explore')}><div class="container festival-story-grid"><div><p class="eyebrow">{l('IL TEMPO DI SCOPRIRE', 'TIME TO DISCOVER')}</p><h2>{l('Un paese.\nMolti incontri.', 'One town.\nMany discoveries.')}</h2></div><div class="festival-story-copy">{c.opening.map(text => <p>{text}</p>)}</div></div></section>
    <section id="riconoscimento" class="festival-plan section" aria-labelledby="recognition-title"><div class="container festival-story-grid"><div><p class="eyebrow">{l('01 / IL RICONOSCIMENTO', '01 / THE RECOGNITION')}</p><h2 id="recognition-title">{c.recognition.title}</h2></div><div class="festival-story-copy">{c.recognition.paragraphs.map(text => <p>{text}</p>)}</div></div></section>
    <section id="timeline" class="borghi-timeline section" aria-labelledby="timeline-title"><div class="borghi-timeline-watermark" aria-hidden="true">2023</div><div class="container borghi-timeline-inner">
      <div class="borghi-timeline-heading"><div><p class="eyebrow">{l('LE TAPPE DI UNA STORIA', 'MILESTONES IN A STORY')}</p><h2 id="timeline-title">{l('Una rete.\nUn nuovo capitolo.', 'One network.\nA new chapter.')}</h2></div><p>{l('Dalla nascita dell’associazione alla bandiera condivisa con la comunità.', 'From the founding of the association to the flag celebrated by the community.')}</p></div>
      <ol class="borghi-timeline-track">
        {c.timeline.map((milestone, i) => <li class:list={['borghi-milestone', { 'borghi-milestone-context': i === 0 }]}>
          <div class="borghi-milestone-date">{milestone.day ? <time datetime={milestone.date}><span class="borghi-milestone-day">{milestone.day}</span><span class="borghi-milestone-month">{milestone.month}</span><span class="borghi-milestone-year">{milestone.year}</span></time> : <div><span class="borghi-milestone-context-year">{milestone.year}</span><span class="borghi-milestone-month">{l('LE ORIGINI DELLA RETE', 'THE NETWORK’S ORIGINS')}</span></div>}</div>
          <span class="borghi-milestone-node" aria-hidden="true"></span>
          <div class="borghi-milestone-copy"><p class="borghi-milestone-index">{l('TAPPA', 'MILESTONE')} / 0{i + 1}</p><h3><a href={timelineLinks[i]}>{milestone.title}<Icon name="diagonal"/></a></h3><p>{milestone.text}</p></div>
        </li>)}
      </ol>
      <div class="borghi-timeline-tail"><span aria-hidden="true"></span><p>{l('Il riconoscimento è parte della storia. La scoperta continua, un passo alla volta.', 'The recognition is part of the story. Discovery continues, one step at a time.')}</p></div>
    </div></section>
    {c.chapters.map((chapter, i) => <><section id={chapter.id} class={i % 2 === 0 ? 'festival-story section' : 'festival-plan section'} aria-labelledby={`${chapter.id}-title`}><div class="container festival-story-grid"><div><p class="eyebrow">{chapter.label}</p><h2 id={`${chapter.id}-title`}>{chapter.title}</h2></div><div class="festival-story-copy">{chapter.paragraphs.map(text => <p>{text}</p>)}{chapterLinks[chapter.id] && <div class="festival-plan-links">{chapterLinks[chapter.id].map(link => <a class="text-link" href={link.href}>{link.label}<Icon name="arrow"/></a>)}</div>}</div></div></section>{chapter.id === 'festa-della-bandiera' && <PhotoStoryGallery lang={lang} items={items} eyebrow={l('30 DICEMBRE 2023 / IL RACCONTO FOTOGRAFICO', '30 DECEMBER 2023 / THE PHOTOGRAPHIC STORY')} heading={l('Le bandiere, i volti,\nla festa.', 'The flags, the faces,\nthe celebration.')} introduction={l('La giornata della bandiera nelle fotografie di Filippo Anello: il corteo, gli sbandieratori e i musici, tra le strade e le piazze di Agira.', 'The flag celebration through Filippo Anello’s photographs: the procession, flag throwers and musicians in Agira’s streets and squares.')}/>}</>)}
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Dai un nome alla curiosità.\nScegli la prossima tappa.', 'Follow your curiosity.\nChoose your next stop.')}</h2></div><div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('sights', lang)}>{l('Cosa vedere ad Agira', 'Things to see in Agira')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('routes', lang)}>{l('Gli itinerari', 'The itineraries')}<Icon name="diagonal"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} alternatePaths={paths}/>
  {structured && <script type="application/ld+json" set:html={serializeSchema(structured)}/>}
</Base>
<style>
  .borghi-timeline{position:relative;isolation:isolate;overflow:hidden;background:var(--forest-dark);color:var(--stone)}
  .borghi-timeline::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 90% 10%,#f2c66d10,transparent 55%)}
  .borghi-timeline-watermark{position:absolute;right:-.025em;top:-.1em;z-index:-1;font-family:var(--display);font-size:clamp(10rem,30vw,32rem);font-weight:600;letter-spacing:-.09em;line-height:1;color:transparent;-webkit-text-stroke:1px #f2c66d24;user-select:none;pointer-events:none}
  .borghi-timeline-inner{position:relative}
  .borghi-timeline-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:3rem;margin-bottom:4rem}
  .borghi-timeline .eyebrow{color:var(--grain)}
  .borghi-timeline-heading>p{max-width:320px;color:#c2d2c8;font-size:.9375rem;line-height:1.6}
  .borghi-timeline-track{list-style:none;margin:0;padding:0;position:relative}
  .borghi-timeline-track::before{content:'';position:absolute;left:calc(192px + 2.5rem);top:2.3rem;bottom:0;width:1px;background:linear-gradient(to bottom,#f2c66d38,var(--grain) 45%,var(--grain))}
  .borghi-milestone{position:relative;display:grid;grid-template-columns:192px 1fr;column-gap:5rem;padding:2.4rem 0 3rem}
  .borghi-milestone+.borghi-milestone{border-top:1px solid #c2d2c81c}
  .borghi-milestone-date time,.borghi-milestone-date>div{display:flex;flex-direction:column;align-items:flex-start}
  .borghi-milestone-day{font-family:var(--display);font-size:clamp(4.8rem,8vw,7rem);line-height:.9;letter-spacing:-.075em;color:var(--grain)}
  .borghi-milestone-month{font-size:.7rem;letter-spacing:.15em;line-height:1.5;margin-top:1rem;color:#e3e9e0;overflow-wrap:anywhere}
  .borghi-milestone-year{font-family:var(--display);font-size:2.1rem;line-height:1.1;letter-spacing:-.04em;color:var(--grain);margin-top:.4rem}
  .borghi-milestone-context-year{font-family:var(--display);font-size:3.7rem;line-height:1;letter-spacing:-.06em;color:#a8bdb0}
  .borghi-milestone-node{position:absolute;left:calc(192px + 2.5rem - 6px);top:3rem;width:13px;height:13px;background:var(--grain);transform:rotate(45deg);box-shadow:0 0 0 8px var(--forest-dark),0 0 0 9px #f2c66d55;transition:box-shadow .25s}
  .borghi-milestone-context .borghi-milestone-node{background:var(--forest-dark);border:1px solid var(--grain)}
  .borghi-milestone:hover .borghi-milestone-node,.borghi-milestone:focus-within .borghi-milestone-node{box-shadow:0 0 0 8px var(--forest-dark),0 0 0 10px var(--grain),0 0 35px #f2c66d44}
  .borghi-milestone-index{font-size:.65rem;letter-spacing:.14em;color:#adc1b4;margin-bottom:1.1rem}
  .borghi-milestone-copy{max-width:610px;padding:.35rem 0 0}
  .borghi-milestone-copy h3{font-size:clamp(1.75rem,3.2vw,2.6rem);line-height:1.12;margin-bottom:1rem}
  .borghi-milestone-copy h3 a{display:inline-flex;gap:1rem;align-items:baseline}
  .borghi-milestone-copy h3 a:hover{text-decoration:underline;text-underline-offset:6px}
  .borghi-milestone-copy h3 :global(svg){width:21px;height:21px;flex-shrink:0;color:var(--grain)}
  .borghi-milestone-copy>p:last-child{font-size:1rem;line-height:1.7;color:#d0ddd3}
  .borghi-timeline-tail{display:grid;grid-template-columns:192px 1fr;column-gap:5rem;padding-top:1.8rem;border-top:1px solid #c2d2c833}
  .borghi-timeline-tail p{max-width:500px;font-size:.875rem;line-height:1.6;color:#c2d2c8}
  @media(max-width:700px){
    .borghi-timeline-heading{display:block;margin-bottom:2rem}
    .borghi-timeline-heading>p{margin-top:1.5rem;max-width:330px}
    .borghi-timeline-watermark{top:.1em;font-size:10.5rem}
    .borghi-timeline-track::before{left:6px;top:2.5rem}
    .borghi-milestone{display:block;padding:2.4rem 0 2.4rem 2.3rem}
    .borghi-milestone-node{left:0;top:3rem}
    .borghi-milestone-date time{display:grid;grid-template-columns:auto 1fr;column-gap:1rem;align-items:end}
    .borghi-milestone-day{grid-row:1/3;font-size:4.2rem}
    .borghi-milestone-month{margin-top:0;font-size:.65rem}
    .borghi-milestone-year{font-size:1.65rem;margin-top:.2rem}
    .borghi-milestone-context-year{font-size:3rem}
    .borghi-milestone-context .borghi-milestone-month{margin-top:.6rem}
    .borghi-milestone-copy{padding-top:1.7rem}
    .borghi-milestone-index{margin-bottom:.75rem}
    .borghi-milestone-copy h3{font-size:1.8rem}
    .borghi-timeline-tail{display:block;padding-left:2.3rem}
  }
  @media(prefers-reduced-motion:reduce){.borghi-milestone-node{transition:none}}
</style>
