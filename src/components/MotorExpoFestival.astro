---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import PhotoStoryGallery from './PhotoStoryGallery.astro';
import Icon from './Icon.astro';
import photos from '../data/photos.json';
import gallery from '../data/motor-expo-gallery.json';
import { motorExpo, getMotorExpo } from '../data/motor-expo';
import { pageUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';
interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = getMotorExpo(lang);
const paths = { it: pageUrl('motorExpo', 'it'), en: pageUrl('motorExpo', 'en') };
const hero = motorExpo.image;
const items = gallery.map(item => ({ key: item.key as keyof typeof photos, title: item.title[lang] }));
const heroUrl = `/images/${hero}-${Math.max(...photos[hero].widths.filter(width => width <= 1800))}.webp`;
// Do not publish Event markup with a fabricated day while only March is confirmed.
const structured = Astro.site?.protocol === 'https:' ? {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'BreadcrumbList', '@id': new URL(paths[lang] + '#breadcrumb', Astro.site).href, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hello Agira', item: new URL(`/${lang}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: l('Eventi', 'Events'), item: new URL(pageUrl('events', lang), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Motor Expo Agira 2027', item: new URL(paths[lang], Astro.site).href },
    ] },
    { '@type': 'WebPage', '@id': new URL(paths[lang] + '#page', Astro.site).href,
      breadcrumb: { '@id': new URL(paths[lang] + '#breadcrumb', Astro.site).href },
      primaryImageOfPage: { '@type': 'ImageObject', contentUrl: new URL(heroUrl, Astro.site).href, caption: photos[hero].alt[lang], creditText: photos[hero].credit[lang], isBasedOn: motorExpo.sourceUrl },
    },
  ],
} : undefined;
---
<Base socialPhoto={hero} lang={lang} title={c.title} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="events" alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="motor-expo-title">
      <div class="container">
        <p class="eyebrow festival-topline">{l('AGIRA · MOTORI E PASSIONI', 'AGIRA · MOTORING AND PASSION')}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <h1 id="motor-expo-title">{c.heading}</h1><p>{c.intro}</p>
            <div class="festival-date-lockup"><span>{l('GIORNI DA CONFERMARE', 'EXACT DATES TO BE CONFIRMED')}</span><div><strong>{lang === 'it' ? '27ª' : '27th'}</strong><p>{l('EDIZIONE', 'EDITION')}<br/>{l('MARZO 2027', 'MARCH 2027')}</p></div></div>
            <a class="button button-yellow" href="#edizione-2027">{l('L’edizione 2027', 'The 2027 edition')}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo">
            <a class="photo-link" href={heroUrl} data-gallery-open={hero} aria-haspopup="dialog" aria-label={l('Ingrandisci la foto del Motor Expo', 'Enlarge the Motor Expo photograph')}><Photo name={hero} lang={lang} priority sizes="(max-width: 700px) 92vw, 48vw"/></a>
            <figcaption><span>{l('Auto d’epoca nel Padiglione · Edizione precedente', 'Classic cars in the pavilion · Previous edition')}</span><a href={motorExpo.sourceUrl} target="_blank" rel="noopener noreferrer">{photos[hero].credit[lang]}</a></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section id="edizione-2027" class="festival-edition" aria-labelledby="motor-edition-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date"><p class="eyebrow">{l('27ª EDIZIONE · INGRESSO GRATUITO', '27TH EDITION · FREE ADMISSION')}</p><h2 id="motor-edition-title">{c.editionTitle}</h2><p>{c.editionText}</p></div>
        <div class="festival-programme"><span class="festival-programme-index" aria-hidden="true">27</span><h3>{c.programmeTitle}</h3><p>{c.programmeText}</p><div class="festival-official-links"><a class="text-link" href={motorExpo.sourceUrl} target="_blank" rel="noopener noreferrer">{l('Gli aggiornamenti del Club', 'Updates from the club')}<Icon name="diagonal"/></a></div></div>
      </div>
    </section>
    {c.sections.map((section, i) => <section id={section.id} class={i % 2 === 0 ? 'festival-story section' : 'festival-plan section'} aria-labelledby={`${section.id}-title`}>
      <div class="container festival-story-grid"><div><p class="eyebrow">{section.label}</p><h2 id={`${section.id}-title`}>{section.title}</h2></div><div class="festival-story-copy">{section.paragraphs.map(text => <p>{text}</p>)}{i === 1 && <p><a class="text-link" href={motorExpo.sourceUrl} target="_blank" rel="noopener noreferrer">{motorExpo.organizer}<Icon name="diagonal"/></a></p>}</div></div>
    </section>)}
    <PhotoStoryGallery lang={lang} items={items} eyebrow={l('03 / IL RACCONTO FOTOGRAFICO', '03 / THE PHOTOGRAPHIC STORY')} heading={l('I motori, le persone,\nla passione.', 'The vehicles, the people,\nthe passion.')} introduction={l('Sette fotografie di un’edizione precedente, dalla pagina Facebook del Club Motori d’Epoca Agira.', 'Seven photographs from a previous edition, from the Club Motori d’Epoca Agira Facebook page.')}/>
    <section class="stay-practical-section section" aria-labelledby="motor-faq-title">
      <div class="container stay-practical-grid"><div class="stay-practical-intro"><p class="eyebrow">{l('04 / PRIMA DI PARTIRE', '04 / BEFORE YOU SET OFF')}</p><h2 id="motor-faq-title">{l('Preparare la visita.', 'Plan your visit.')}</h2></div><div class="stay-practical-list">{c.faqs.map((faq, i) => <details><summary><span class="small-number">0{i + 1}</span><h3>{faq.q}</h3><Icon name="plus"/></summary><div class="stay-practical-answer"><p>{faq.a}</p></div></details>)}</div></div>
    </section>
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}><div class="container itinerary-next-inner"><div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Vieni per i motori.\nFermati per Agira.', 'Come for the cars.\nStay for Agira.')}</h2></div><div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('events', lang)}>{l('Tutti gli eventi', 'All events')}<Icon name="arrow"/></a><a class="text-link" href={pageUrl('stay', lang)}>{l('Dove dormire', 'Where to stay')}<Icon name="diagonal"/></a></div></div></section>
  </main>
  <SiteFooter lang={lang} currentPage="events" alternatePaths={paths}/>
  {structured && <script type="application/ld+json" set:html={serializeSchema(structured)}/>}
</Base>
