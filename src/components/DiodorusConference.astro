---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { conference, conferenceCopy, conferenceGraph } from '../data/diodorus-conference';
import { imageFile } from '../lib/image-metadata';
import { pageUrl, sightUrl, type Locale } from '../lib/i18n';
import { serializeSchema } from '../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = (it: string, en: string) => lang === 'it' ? it : en;
const c = conferenceCopy(lang);
const paths = { it: pageUrl('diodorusConference', 'it'), en: pageUrl('diodorusConference', 'en') };
const graph = Astro.site?.protocol === 'https:' ? conferenceGraph(Astro.site, lang) : undefined;
const [beforeBook, afterBook] = c.description.split(c.book);
const programme = [
  ['16:00', '4:00 pm', l('Apertura', 'Opening')],
  ['18:00', '6:00 pm', l('Seconda sessione', 'Second session')],
  ['19:30', '7:30 pm', l('Conclusioni', 'Closing remarks')],
];
---
<Base socialPhoto={conference.image} lang={lang} title={c.name + ' | Hello Agira'} description={c.description} canonicalPath={paths[lang]} alternatePaths={paths}>
  <SiteHeader lang={lang} currentPage="events" alternatePaths={paths}/>
  <main id="main" tabindex="-1">
    <section class="route-page-hero festival-hero" aria-labelledby="conference-title">
      <div class="container">
        <p class="eyebrow festival-topline">AGIRA · {c.category}</p>
        <div class="festival-hero-grid">
          <div class="route-page-copy">
            <h1 id="conference-title">{c.name}</h1>
            <p><time datetime={conference.start}>{c.date}</time><br/><a href={sightUrl('salvatore', lang)}>{c.venue}</a><br/>{c.admission}</p>
            <p>{beforeBook}<em>{c.book}</em>{afterBook} {c.body}</p>
            <a class="button button-yellow" href="#programma">{l('Vedi il programma', 'View the programme')}<Icon name="arrow"/></a>
          </div>
          <figure class="route-page-photo festival-hero-photo conference-poster">
            <a class="photo-link" href={imageFile(conference.image, 1049)} aria-label={l('Apri la locandina a grandezza intera', 'Open the full-size event poster')}>
              <Photo name={conference.image} lang={lang} priority sizes="(max-width: 700px) 92vw, 42vw"/>
            </a>
            <figcaption><span>{c.credit}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section id="programma" class="festival-edition" aria-labelledby="programme-title">
      <div class="container festival-edition-grid">
        <div class="festival-edition-date">
          <p class="eyebrow">{l('SABATO 21 NOVEMBRE 2026', 'SATURDAY 21 NOVEMBER 2026')}</p>
          <h2 id="programme-title">{l('Il programma.', 'The programme.')}</h2>
          <ul>{programme.map(([time, timeEn, label]) => <li><time datetime={time}>{l(time, timeEn)}</time> · {label}</li>)}</ul>
        </div>
        <div class="festival-programme">
          <h3>{l('Organizzazione e contatti', 'Organiser and contact')}</h3>
          <p>{c.organizer}</p>
          <div class="festival-official-links">
            <a class="text-link" href={conference.website}>Fondazione Franzone<Icon name="diagonal"/></a>
            <a class="text-link" href={`mailto:${conference.email}`}>{conference.email}</a>
          </div>
        </div>
      </div>
    </section>
    <section class="itinerary-next" aria-label={l('Continua a esplorare', 'Keep exploring')}>
      <div class="container itinerary-next-inner">
        <div><p class="eyebrow">{l('IL VIAGGIO CONTINUA', 'KEEP EXPLORING')}</p><h2>{l('Altri appuntamenti ad Agira.', 'More events in Agira.')}</h2></div>
        <div class="itinerary-next-links"><a class="button button-yellow" href={pageUrl('events', lang)}>{l('Tutti gli eventi', 'All events')}<Icon name="arrow"/></a></div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} currentPage="events" alternatePaths={paths}/>
  {graph && <script type="application/ld+json" set:html={serializeSchema(graph)}/>}
</Base>

<style>
  .festival-hero .conference-poster .photo-link{height:auto;max-height:none;aspect-ratio:auto;border-radius:2px;cursor:zoom-in}
  .conference-poster :global(img){display:block;width:100%;height:auto;aspect-ratio:auto;object-fit:contain}
  .route-page-copy p a{text-decoration:underline;text-underline-offset:.15em}
  .festival-edition-date ul{padding-inline-start:1.25rem}
</style>
